}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000200",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "For normal range values that are character in ordinal scale or if categorical ranges were supplied (e.g., -1 to +1; NEGATIVE TO TRACE)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
