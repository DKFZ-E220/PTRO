    "@value" : "RFENDTC"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Reference end date/time for the subject in ISO 8601 format. Usually equivalent to the date/time when the subject was determined to have left the study."
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000124",
