  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Description of toxicity quantified by LBTOXGR. The sponsor is expected to provide the name and version of the scale used to map the terms, utilizing the data definition file external codelist attributes."
  } ],
