  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Used to indicate a derived record. The value should be Y or null. Records that represent the average of other records, or are not as originally received or collected, are examples of records that might be derived for the submission datasets."
  } ],
