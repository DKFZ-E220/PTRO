    "@value" : "RFXSTDTC"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "First date/time of exposure to any protocol-specified treatment or therapy, equal to the earliest value of EXSTDTC. Note: Absolute first."
  } ]
}, {
