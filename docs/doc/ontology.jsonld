  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000175",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The reason the result should be excluded from all calculations. Used only when CLEXCLFL is Y."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
  } ],
