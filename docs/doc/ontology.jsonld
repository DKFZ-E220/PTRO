  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "EXELTM"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000144",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Name of the fixed reference point referred to by EXELTM, if used for EXTPTNUM, and EXTPT. It is recommended that EXTPTREF be as descriptive as possible so the reference time point can be inferred without looking at other variables. Examples: Previous dose, previous feed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"
