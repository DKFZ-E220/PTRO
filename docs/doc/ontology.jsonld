    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLELTM"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000185",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Name of the fixed reference point referred to by CLELTM, if used for CLTPTNUM, and CLTPT. It is recommended that CLTPTREF be as descriptive as possible, so the reference time point can be inferred without looking at other variables. Examples: PREVIOUS DOSE, PREVIOUS MEAL."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
