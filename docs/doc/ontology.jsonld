  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLREASEX"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000176",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates whether the timing of a performed test or observation was unscheduled. If a test or observation was performed based upon a schedule defined in the protocol, this flag should be null. Expected values are Y or null."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unscheduled_Flag"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLUSCHFL"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000177",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Date/Time of the clinical observation in ISO 8601 format. For measurements related to a continuous evaluation interval, CLDTC should be used to indicate the start date/time of that interval."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Date_Time_of_Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLDTC"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000178",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Date/Time of end of observation interval, in ISO 8601 format. Should be populated when CLDTC represents the start date/time of a continuous evaluation interval."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "End_Date_Time_of_Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLENDTC"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000179",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Study day of the end of observation, in integer days. Can be populated when CLDY represents the start day of a continuous evaluation interval. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Study_Day_of_End_of_Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLENDY"
  } ]
}, {
  "@id" : "https://purls.helmholtz-metadaten.de/ptro/DKFZ000180",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Nominal study day used for grouping records for observations that may occur on different days into a single reported study day. Should be an integer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Nominal_Study_Day_for_Tabulations"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "CLNOMDY"
  } ]
