    "@value" : "S.V.Ilango"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Indicates whether the timing of the specimen collection was unscheduled. If a specimen collection was performed based upon a schedule defined in the protocol, this flag should be null. Expected values are Y or null."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
