  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@value" : "RFXENDTC"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Last date/time of exposure to any protocol-specified treatment or therapy, equal to the latest value of EXENDTC (or the latest value of EXSTDTC if EXENDTC was not collected or is missing)."
  } ]
}, {
