        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>CDISC</rdfs:isDefinedBy>
        <rdfs:label>Subject_Reference_End_Date/Time</rdfs:label>
        <skos:altLabel>RFENDTC</skos:altLabel>
        <skos:definition>Reference end date/time for the subject in ISO 8601 format. Usually equivalent to the date/time when the subject was determined to have left the study.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000124 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000124">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:label>Date_Time_of_First_Study_Treatment</rdfs:label>
        <skos:altLabel>RFXSTDTC</skos:altLabel>
        <skos:definition>First date/time of exposure to any protocol-specified treatment or therapy, equal to the earliest value of EXSTDTC. Note: Absolute first.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000125 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000125">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>Date_Time_of_Last_Study_Treatment</rdfs:label>
        <skos:altLabel>RFXENDTC</skos:altLabel>
        <skos:definition>Last date/time of exposure to any protocol-specified treatment or therapy, equal to the latest value of EXENDTC (or the latest value of EXSTDTC if EXENDTC was not collected or is missing).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000126 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000126">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>SIlango</dc:creator>
        <rdfs:label>Study_Site_Identifier</rdfs:label>
        <skos:altLabel>SITEID</skos:altLabel>
        <skos:definition>Unique identifier for a study site within a submission.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000127 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000127">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Date_Time_of_Birth</rdfs:label>
        <skos:altLabel>BIRTHDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000128 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000128">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Species</rdfs:label>
        <skos:altLabel>SPECIES</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000129 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000129">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Free-text field that allows the sponsor to enter further details qualifiying the SPECIES and/or STRAIN, depending on the level to which these variables were defined. Examples include the description of a specific genetic alteration, country of origin for non-human primates, details related to coat color (e.g., White and Red designations for New Zealand Rabbits), and important animal husbandry information (e.g., SPF, BR, VAF).</rdfs:comment>
        <rdfs:label>Strain_Substrain_Details</rdfs:label>
        <skos:altLabel>SBSTRAIN</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000130 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000130">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The sequence number must be unique for each record with a USUBJID or POOLID</rdfs:comment>
        <rdfs:label>Sequence_Number</rdfs:label>
        <skos:altLabel>EXSEQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000131 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000131">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Identification of focus of study-specific interest on or withina subject or specimen as defined in protocol.</rdfs:comment>
        <rdfs:label>Focus_Of_Study_Specific_Interest</rdfs:label>
        <skos:altLabel>FOCID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000132 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000132">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>If the amount of treatment administered cannot be represented as a number and populated in EXDOSE, this field is used to describe the amount of treatment administered. Example: 200-400.</rdfs:comment>
        <rdfs:label>Dose_Description</rdfs:label>
        <skos:altLabel>EXDOSTXT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000133 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000133">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Dose form of treatment.</rdfs:comment>
        <rdfs:label>Dose_Form</rdfs:label>
        <skos:altLabel>EXDOSFRM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000134 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000134">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Usually expressed as the number of repeated administrations of EXDOSE within a specific time period.</rdfs:comment>
        <rdfs:label>Dosing_Frequency_Per_Interval</rdfs:label>
        <skos:altLabel>EXDOSFRQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000135 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000135">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Lot Number(s) or Batch Number(s) of the EXTRT test article. If mixed lots of the test article are administered during the same constant dosing interval, this should be represented as &quot;Lot A;Lot B.&quot; Mixed lots are produced by the mixing of Lots a and B of the test article into one solution.</rdfs:comment>
        <rdfs:label>Lot_Number</rdfs:label>
        <skos:altLabel>EXLOT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000136 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000136">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Specifies anatomical location (site) of administration. Example: LEFT HINDLIMB for a topical application or an injection site number. Each administration will require its own record.</rdfs:comment>
        <rdfs:label>Location_Of_Dose_Administration</rdfs:label>
        <skos:altLabel>EXLOC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000137 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000137">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>EXMETHOD</dc:creator>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Method of dose administration.</rdfs:comment>
        <rdfs:label>Method_Of_Administration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000138 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000138">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Describes reason or explanation of why a dose is adjusted – used only when an adjustment is represented in EX. May be used for variations from protocol-specified doses or changes from expected doses (e.g., when dose is adjusted due to toxicity).</rdfs:comment>
        <rdfs:label>Reason_For_Dose_Adjustment</rdfs:label>
        <skos:altLabel>EXADJ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000139 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000139">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time when administration of the treatment indicated by EXTRT and EXDOSE began, in ISO 8601 format.</rdfs:comment>
        <rdfs:label>Start_Date_Time_Of_Treatment</rdfs:label>
        <skos:altLabel>EXSTDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000140 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000140">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time when administration of the treatment indicated by EXTRT and EXDOSE ended, in ISO 8601 format.</rdfs:comment>
        <rdfs:label>End_Date_Time_Of_Char_Treatment</rdfs:label>
        <skos:altLabel>EXENDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000141 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000141">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Text description of time when a dose should be given. Note: This may be represented as an elapsed time relative to a fixed reference point, such as time of last dose. See EXTPTNUM and EXTPTREF.</rdfs:comment>
        <rdfs:label>Planned_Time_Point_Name</rdfs:label>
        <skos:altLabel>EXTPT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000142 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000142">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Numerical version of EXTPT to aid in sorting.</rdfs:comment>
        <rdfs:label>Planned_Time_Point_Number</rdfs:label>
        <skos:altLabel>EXTPTNUM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000143 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000143">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Planned elapsed time (in ISO 8601 format) relative to the planned fixed reference (EXTPTREF). This variable is useful where there are repetitive measures. Not a clock time or a date time variable. Represented as an ISO 8601 duration. Examples: &quot;- PT15M&quot; to represent the period of 15 minutes prior to the reference point indicated by EXTPTREF, or &quot;PT8H&quot; to represent the period of 8 hours after the reference point indicated by EXTPTREF.</rdfs:comment>
        <rdfs:label>Planned_Elapsed_Time_From_Time_Point_Ref</rdfs:label>
        <skos:altLabel>EXELTM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000144 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000144">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Name of the fixed reference point referred to by EXELTM, if used for EXTPTNUM, and EXTPT. It is recommended that EXTPTREF be as descriptive as possible so the reference time point can be inferred without looking at other variables. Examples: Previous dose, previous feed.</rdfs:comment>
        <rdfs:label>Time_Point_Reference</rdfs:label>
        <skos:altLabel>EXTPTREF</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000145 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000145">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of the reference time point, EXTPTREF</rdfs:comment>
        <rdfs:label>Date_Time_Of_Reference_Time_Point</rdfs:label>
        <skos:altLabel>EXRFTDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000146 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000146">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.ILANGO</dc:creator>
        <rdfs:comment>The sequence number must be unique for each record within a USUBJID or POOLID, whichever applies for the record.</rdfs:comment>
        <rdfs:label>Sequence_Number</rdfs:label>
        <skos:altLabel>COSEQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000147 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000147">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>COREF</dc:creator>
        <dc:creator>S.V.ILANGO</dc:creator>
        <rdfs:comment>Sponsor-defined reference associated with the comment. May be the logbook page number, name (e.g., Logbook), or a combination of information that identifies the reference (e.g., Logbook, page 650, Day 28, morning).</rdfs:comment>
        <rdfs:label>Comment_Reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000148 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000148">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Sequence number given to ensure uniqueness of subject records within a domain. May be any valid number.</rdfs:comment>
        <rdfs:label>Sequence_Number</rdfs:label>
        <skos:altLabel>BWSEQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000149 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000149">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Contains the result value for all findings, copied or derived from BWORRES in a standard format or standard units. BWSTRESC should store all results or findings in character format; if results are numeric, they should also be submitted in numeric format in BWSTRESN.</rdfs:comment>
        <rdfs:label>Standardized_Result_in_Character_Format</rdfs:label>
        <skos:altLabel>BWSTRESC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000150 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000150">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used for numeric results or findings in standard format; contains the numeric form of BWSTRESC. BWSTRESN should store all numeric test results or findings.</rdfs:comment>
        <rdfs:label>Standardized_Result_in_Numeric_Format</rdfs:label>
        <skos:altLabel>BWSTRESN</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000151 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000151">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Standardised unit for BWSTRESC , BWSTRESN.</rdfs:comment>
        <rdfs:label>Unit_of_the_Standardized_Result</rdfs:label>
        <skos:altLabel>BWSTRESU</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000152 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000152">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to indicate if a test is done or missing.</rdfs:comment>
        <rdfs:label>Completion_Status</rdfs:label>
        <skos:altLabel>BWSTAT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000153 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000153">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Describe why BSTAT was not done.</rdfs:comment>
        <rdfs:label>Reason_Not_Done</rdfs:label>
        <skos:altLabel>BWREASND</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000154 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000154">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>A baseline indicator may be used to calculate differences or changes from baseline.</rdfs:comment>
        <rdfs:label>Baseline_Flag</rdfs:label>
        <skos:altLabel>BWBLFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000155 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000155">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to identify fasting status.</rdfs:comment>
        <rdfs:label>Fasting_Status</rdfs:label>
        <skos:altLabel>BWFAST</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000156 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000156">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Y if the result should be excluded from all calculations, otherwise null.</rdfs:comment>
        <rdfs:label>Exclusion_Flag</rdfs:label>
        <skos:altLabel>BWEXCLFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000157 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000157">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Reason_For_Exclusion</rdfs:label>
        <skos:altLabel>BWREASEX</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000158 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000158">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Unscheduled_Flag</rdfs:label>
        <skos:altLabel>BWUSCHFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000159 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000159">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Planned_Study_Day_of_Collection</rdfs:label>
        <skos:altLabel>VISITDY</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000160 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000160">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Date_Time_Animal_Weighed</rdfs:label>
        <skos:altLabel>BWDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000161 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000161">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Nominal_Study_Day_For_Tabulations</rdfs:label>
        <skos:altLabel>BWNOMDY</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000162 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000162">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>Sequence_Number</rdfs:label>
        <skos:altLabel>DDSEQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000163 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000163">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:label>Result_or_Findings_as_Collected</rdfs:label>
        <skos:altLabel>DDORRES</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000164 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000164">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Contains diagnosis information, derived or taken from DDORRES in standardized format.</rdfs:comment>
        <rdfs:label>Standardized_Result_in_Character_Format</rdfs:label>
        <skos:altLabel>DDSTRESC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000165 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000165">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The date/time of subject disposition, in ISO8601 format.</rdfs:comment>
        <rdfs:label>Date_Time</rdfs:label>
        <skos:altLabel>DDDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000166 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000166">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The sequence number must be unique for each record within a USUBJID or POOLID, whichever applies for the record.</rdfs:comment>
        <rdfs:label>Sequence_Number</rdfs:label>
        <skos:altLabel>CLSEQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000167 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000167">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to tie together a block of related records in a single domain for a subject or pool. This is not the treatment group number.</rdfs:comment>
        <rdfs:label>Group_Identifier</rdfs:label>
        <skos:altLabel>CLGRPID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000168 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000168">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Mass identifier such as MASS 1 or MASS A. Used when the mass was discovered during the in-life phase and assigned a mass identifier. The mass identification should be unique within the subject, regardless of mass location</rdfs:comment>
        <rdfs:label>Mass_Identifier</rdfs:label>
        <skos:altLabel>CLSPID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000169 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000169">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Text description of the finding as originally received or collected. If the examination was not performed on a particular body system, or at the subject level, then the value should be null, and NOT DONE should appear in CLSTAT.</rdfs:comment>
        <rdfs:label>Result_or_Findings_as_Collected</rdfs:label>
        <skos:altLabel>CLORRES</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000170 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000170">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The base finding from CLORRES without modifiers. If the examination was completed and there were no abnormal findings, the value must be NORMAL.</rdfs:comment>
        <rdfs:label>Standardized_Result_in_Character_Format</rdfs:label>
        <skos:altLabel>CLSTRESC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000171 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000171">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Describes why CLSTAT is NOT DONE, such as SUBJECT MORIBUND.</rdfs:comment>
        <rdfs:label>Reason_Not_Done</rdfs:label>
        <skos:altLabel>CLREASND</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000172 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000172">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Can be used to specify where a clinical sign occurred. Example: LEFT EAR for skin rash.</rdfs:comment>
        <rdfs:label>Location_of_a_Finding</rdfs:label>
        <skos:altLabel>CLLOC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000173 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000173">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Describes the severity or intensity of a particular finding.</rdfs:comment>
        <rdfs:label>Severity</rdfs:label>
        <skos:altLabel>CLSEV</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000174 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000174">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Y if the result should be excluded from all calculations, otherwise null.</rdfs:comment>
        <rdfs:label>Exclusion_Flag</rdfs:label>
        <skos:altLabel>CLEXCLFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000175 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000175">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The reason the result should be excluded from all calculations. Used only when CLEXCLFL is Y.</rdfs:comment>
        <rdfs:label>Reason_for_Exclusion</rdfs:label>
        <skos:altLabel>CLREASEX</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000176 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000176">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Indicates whether the timing of a performed test or observation was unscheduled. If a test or observation was performed based upon a schedule defined in the protocol, this flag should be null. Expected values are Y or null.</rdfs:comment>
        <rdfs:label>Unscheduled_Flag</rdfs:label>
        <skos:altLabel>CLUSCHFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000177 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000177">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of the clinical observation in ISO 8601 format. For measurements related to a continuous evaluation interval, CLDTC should be used to indicate the start date/time of that interval.</rdfs:comment>
        <rdfs:label>Date_Time_of_Observation</rdfs:label>
        <skos:altLabel>CLDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000178 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000178">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of end of observation interval, in ISO 8601 format. Should be populated when CLDTC represents the start date/time of a continuous evaluation interval.</rdfs:comment>
        <rdfs:label>End_Date_Time_of_Observation</rdfs:label>
        <skos:altLabel>CLENDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000179 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000179">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Study day of the end of observation. Can be populated when CLENDTC represents the start day of a continuous evaluation interval. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</rdfs:comment>
        <rdfs:label>Study_Day_of_End_of_Observation</rdfs:label>
        <skos:altLabel>CLENDY</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000180 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000180">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Nominal study day used for grouping records for observations that may occur on different days into a single reported study day. Should be an integer.</rdfs:comment>
        <rdfs:label>Nominal_Study_Day_for_Tabulations</rdfs:label>
        <skos:altLabel>CLNOMDY</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000181 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000181">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>A label for a given value of CLNOMDY as presented in the study report. Examples: Week 4, Day 28, Terminal Sac.</rdfs:comment>
        <rdfs:label>Label_for_Nominal_Study_Day</rdfs:label>
        <skos:altLabel>CLNOMLBL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000182 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000182">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Text description of time when an observation should be taken, as defined in the protocol. This may be represented as an elapsed time relative to a fixed reference point, such as time postdose.</rdfs:comment>
        <rdfs:label>Planned_Time_Point_Name</rdfs:label>
        <skos:altLabel>CLTPT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000183 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000183">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Numerical version of CLTPT to aid in sorting.</rdfs:comment>
        <rdfs:label>Planned_Time_Point_Number</rdfs:label>
        <skos:altLabel>CLTPTNUM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000184 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000184">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Planned Elapsed time (in ISO 8601 format) relative to a planned reference (CLTPTREF). This variable is useful where there are repetitive measures. Not a clock time or a date time variable. Represented as an ISO 8601 duration. Examples: -PT15M to represent the period of 15 minutes prior to the reference point indicated by CLTPTREF, or PT8H to represent the period of 8 hours after the reference point indicated by CLTPTREF.</rdfs:comment>
        <rdfs:label>Planned_Elapsed_Time_from_Time_Point_Ref</rdfs:label>
        <skos:altLabel>CLELTM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000185 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000185">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Name of the fixed reference point referred to by CLELTM, if used for CLTPTNUM, and CLTPT. It is recommended that CLTPTREF be as descriptive as possible, so the reference time point can be inferred without looking at other variables. Examples: PREVIOUS DOSE, PREVIOUS MEAL.</rdfs:comment>
        <rdfs:label>Time_Point_Reference</rdfs:label>
        <skos:altLabel>CLTPTREF</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000186 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000186">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of the reference time point, CLTPTREF.</rdfs:comment>
        <rdfs:label>Date_Time_of_Reference_Time_Point</rdfs:label>
        <skos:altLabel>CLRFTDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000187 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000187">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The sequence number must be unique for each record within a USUBJID or POOLID, whichever applies for the record.</rdfs:comment>
        <rdfs:label>Sequence_Number</rdfs:label>
        <skos:altLabel>LBSEQ</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000188 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000188">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to tie together a block of related records in a single domain for a subject or pool. This is not the treatment group number.</rdfs:comment>
        <rdfs:label>Group_Identifier</rdfs:label>
        <skos:altLabel>LBGRPID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000189 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000189">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Internal or external specimen identifier. Example: 1009570101.</rdfs:comment>
        <rdfs:label>Specimen_Identifier</rdfs:label>
        <skos:altLabel>LBREFID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000190 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000190">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Sponsor-defined reference identifier. Example: Line number on the Lab page.</rdfs:comment>
        <rdfs:label>Sponsor-Defined_Identifier</rdfs:label>
        <skos:altLabel>LBSPID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000191 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000191">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to define a category of the lab test performed. Examples: URINALYSIS, CLINICAL CHEMISTRY, HEMATOLOGY, etc.</rdfs:comment>
        <rdfs:label>Category_for_Lab_Test</rdfs:label>
        <skos:altLabel>LBCAT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000192 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000192">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>A further categorization of a test category. Examples: DIFFERENTIAL, LIVER FUNCTION, ELECTROLYTES.</rdfs:comment>
        <rdfs:label>Subcategory_for_Lab_Test</rdfs:label>
        <skos:altLabel>LBSCAT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000193 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000193">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Lower end of reference range used at the time of collection for continuous measurements in original units. Should be populated only for continuous results.</rdfs:comment>
        <rdfs:label>Reference_Range_Lower_Limit-Orig_Unit</rdfs:label>
        <skos:altLabel>LBORNRLO</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000194 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000194">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Upper end of reference range used at the time of collection for continuous measurements in original units. Should be populated only for continuous results.</rdfs:comment>
        <rdfs:label>Reference_Range_Upper_Limit-Orig_Unit</rdfs:label>
        <skos:altLabel>LBORNRHI</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000195 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000195">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Contains the result value for all findings, copied or derived from LBORRES, in a standard format or standard units. LBSTRESC should store all results or findings in character format; if results are numeric, they should also be submitted in numeric format in LBSTRESN.</rdfs:comment>
        <rdfs:label>Standardized_Result_in_Character_Format</rdfs:label>
        <skos:altLabel>LBSTRESC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000196 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000196">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used for numeric results or findings in standard format; contains the numeric form of LBSTRESC. LBSTRESN should store all numeric test results or findings.</rdfs:comment>
        <rdfs:label>Standardized_Result_in_Numeric_Format</rdfs:label>
        <skos:altLabel>LBSTRESN</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000197 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000197">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Standardized unit used for LBSTRESC and LBSTRESN.</rdfs:comment>
        <rdfs:label>Unit_of_the_Standardized_Result</rdfs:label>
        <skos:altLabel>LBSTRESU</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000198 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000198">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Lower end of reference range for continuous measurements in standardized units. Should be populated only for continuous results.</rdfs:comment>
        <rdfs:label>Reference_Range_Lower_Limit-Std_Unit</rdfs:label>
        <skos:altLabel>LBSTNRLO</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000199 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000199">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Upper end of reference range for continuous measurements in standardized units. Should be populated only for continuous results.</rdfs:comment>
        <rdfs:label>Reference_Range_Upper_Limit-Std_Unit</rdfs:label>
        <skos:altLabel>LBSTNRHI</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000200 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000200">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>For normal range values that are character in ordinal scale or if categorical ranges were supplied (e.g., -1 to +1; NEGATIVE TO TRACE).</rdfs:comment>
        <rdfs:label>Reference_Range_for_Char_Rslt-Std_Unit</rdfs:label>
        <skos:altLabel>LBSTNRC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000201 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000201">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Indicates where value falls with respect to reference range defined by LBORNRLO and LBORNRHI, LBSTNRLO and LBSTNRHI, or by LBSTNRC. Examples: NORMAL, ABNORMAL, HIGH, LOW. Should not be used to indicate biological significance.</rdfs:comment>
        <rdfs:label>Reference_Range_Indicator</rdfs:label>
        <skos:altLabel>LBNRIND</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000202 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000202">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to indicate when a test is not done or result is missing. Should be null if a result exists in LBORRES.</rdfs:comment>
        <rdfs:label>Completion_Status</rdfs:label>
        <skos:altLabel>LBSTAT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000203 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000203">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Describes why LBSTAT is NOT DONE, such as BROKEN EQUIPMENT or SPECIMEN LOST.</rdfs:comment>
        <rdfs:label>Reason_Not_Done</rdfs:label>
        <skos:altLabel>LBREASND</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000204 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000204">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Defines the type of specimen analyzed to obtain the measurement or finding. Examples: WHOLE BLOOD, SERUM, PLASMA, URINE, LIVER, HEART.</rdfs:comment>
        <rdfs:label>Specimen_Material_Type</rdfs:label>
        <skos:altLabel>LBSPEC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000205 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000205">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Location relevant to the collection of specimen for the measurement.</rdfs:comment>
        <rdfs:label>Specimen_Collection_Location</rdfs:label>
        <skos:altLabel>LBLOC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000206 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000206">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Qualifier for laterality of the specimen within the subject for paired specimens. Examples: LEFT, RIGHT, BILATERAL.</rdfs:comment>
        <rdfs:label>Specimen_Laterality_within_Subject</rdfs:label>
        <skos:altLabel>LBLAT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000207 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000207">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Qualifier for directionality of the specimen within the subject. Examples: DORSAL, PROXIMAL.</rdfs:comment>
        <rdfs:label>Specimen_Directionality_within_Subject</rdfs:label>
        <skos:altLabel>LBDIR</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000208 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000208">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Indicator used to identify fasting status. The value should be Y or null.</rdfs:comment>
        <rdfs:label>Fasting_Status</rdfs:label>
        <skos:altLabel>LBFAST</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000209 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000209">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Used to indicate a derived record. The value should be Y or null. Records that represent the average of other records, or are not as originally received or collected, are examples of records that might be derived for the submission datasets.</rdfs:comment>
        <rdfs:label>Derived_Flag</rdfs:label>
        <skos:altLabel>LBDRVFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000210 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000210">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Description of toxicity quantified by LBTOXGR. The sponsor is expected to provide the name and version of the scale used to map the terms, utilizing the data definition file external codelist attributes.</rdfs:comment>
        <rdfs:label>Toxicity</rdfs:label>
        <skos:altLabel>LBTOX</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000211 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000211">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Records toxicity grade value using a standard toxicity scale (such as the NCI CTCAE). If value is from a numeric scale, represent only the number (e.g., 2 and not Grade 2).</rdfs:comment>
        <rdfs:label>Standard_Toxicity_Grade</rdfs:label>
        <skos:altLabel>LBTOXGR</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000212 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000212">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Y if the result should be excluded from all calculations, otherwise null.</rdfs:comment>
        <rdfs:label>Exclusion_Flag</rdfs:label>
        <skos:altLabel>LBEXCLFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000213 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000213">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>The reason the result should be excluded from all calculations. Used only when LBEXCLFL is Y.</rdfs:comment>
        <rdfs:label>Reason_for_Exclusion</rdfs:label>
        <skos:altLabel>LBREASEX</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000214 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000214">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Indicates whether the timing of the specimen collection was unscheduled. If a specimen collection was performed based upon a schedule defined in the protocol, this flag should be null. Expected values are Y or null.</rdfs:comment>
        <rdfs:label>Unscheduled_Flag</rdfs:label>
        <skos:altLabel>LBUSCHFL</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000215 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000215">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of specimen collection, in ISO 8601 format.</rdfs:comment>
        <rdfs:label>Date_Time_of_Specimen_Collection</rdfs:label>
        <skos:altLabel>LBDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000216 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000216">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of the end of specimen collection in ISO 8601 format. Should be populated only for continuous sample collection.</rdfs:comment>
        <rdfs:label>End_Date_Time_of_Specimen_Collection</rdfs:label>
        <skos:altLabel>LBENDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000217 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000217">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Text description of time when specimen should be taken. This may be represented as an elapsed time relative to a fixed reference point, such as time of last dose. Examples: Start, 5 min post.</rdfs:comment>
        <rdfs:label>Planned_Time_Point_Name</rdfs:label>
        <skos:altLabel>LBTPT</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000218 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000218">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Numerical version of LBTPT to aid in sorting.</rdfs:comment>
        <rdfs:label>Planned_Time_Point_Number</rdfs:label>
        <skos:altLabel>LBTPTNUM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000219 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000219">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Elapsed time (in ISO 8601 format) relative to a planned fixed reference (LBTPTREF). This variable is useful where there are repetitive measures. Not a clock time or a date time variable. Represented as an ISO 8601 duration. Examples: -P15M to represent the period of 15 minutes prior to the reference point indicated by LBTPTREF, or P8H to represent the period of 8 hours after the reference point indicated by LBTPTREF.</rdfs:comment>
        <rdfs:label>Planned_Elapsed_Time_from_Time_Point_Ref</rdfs:label>
        <skos:altLabel>LBELTM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000220 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000220">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Name of the fixed reference point referred to by LBELTM, if used for LBTPTNUM, and LBTPT. It is recommended that LBTPTREF be as descriptive as possible so the reference time point can be inferred without looking at other variables. Examples: PREVIOUS DOSE, PREVIOUS MEAL.</rdfs:comment>
        <rdfs:label>Time_Point_Reference</rdfs:label>
        <skos:altLabel>LBTPTREF</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000221 -->


