        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Death_Diagnosis_Short_Name</rdfs:label>
        <skos:altLabel>DDTESTCD</skos:altLabel>
        <skos:definition>Short name of the measurement, test, or examination described in DDTEST. It can be used as a column name when converting a dataset from a vertical to a horizontal format. The value in DDTESTCD cannot be longer than 8 characters, nor can it start with a number (e.g., &quot;1TEST&quot; is not valid). DDTESTCD cannot contain characters other than letters, numbers, or underscores.</skos:definition>
        <skos:exactMatch>Thesaurus:C89966 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C89966)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000020 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000020">
