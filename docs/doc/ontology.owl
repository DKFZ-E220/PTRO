     -->


    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14238 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14238">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T015"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Mouse</rdfs:label>
        <skos:definition>Any of numerous species of small rodents belonging to the genus Mus and various related genera of the family Muridae.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25364 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25364">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T170"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Identifier</rdfs:label>
        <skos:definition xml:lang="en">One or more characters used to identify, name, or characterize the nature, properties, or contents of a thing.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49569 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49569">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Comment Domain</rdfs:label>
        <skos:altLabel>CO, Comments</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to comments.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49572 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49572">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Demographics Domain</rdfs:label>
        <skos:altLabel>Demographics, DM</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to comments.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49587 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49587">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Exposure Domain</rdfs:label>
        <skos:altLabel>EX, Exposure</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to exposure.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49592 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49592">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Laboratory Data Domain</rdfs:label>
        <skos:altLabel>Laboratory Test Results, LB</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to laboratory data.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C54100 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C54100">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Universally Unique Identifier</rdfs:label>
        <skos:definition xml:lang="en">A 128 bit identifier. Depending on the mechanism used to generate it, it is either guaranteed to be different from all other UUIDs/GUIDs generated until 3400 AD or extremely likely to be different. Its relatively small size lends itself well to sorting, ordering, and hashing of all sorts, storing in databases, simple allocation, and ease of programming in general.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T077"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Domain</rdfs:label>
        <skos:definition>An area of knowledge considered as a discrete unit for some purpose.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69219 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69219">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71160"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Series Instance UID</rdfs:label>
        <skos:definition xml:lang="en">A unique identifier for series of images.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663"/>
        <rdfs:comment>aka &apos;Unique Subject Identifier (USUBJID)&apos; at CDISC; and &apos;Subject Id&apos; at RPB.</rdfs:comment>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Subject Unique Identifier</rdfs:label>
        <skos:definition>A unique identifier for a subject in a study.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25364"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Unique Identifier</rdfs:label>
        <skos:definition xml:lang="en">A set of characters used as a code that is unique in the context or the system for which it is created. It serves as a means of identification and reference (often instead of a name) for an entity, person, thing, function, procedure, activity, variable, or body of data.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71160 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71160">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Instance Unique Identifier</rdfs:label>
        <skos:definition xml:lang="en">Data type unique identifier within a particular context.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083">
        <owl:equivalentClass rdf:resource="https://purls.helmholtz-metadaten.de/ptro/DKFZ000006"/>
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25364"/>
        <rdfs:comment>aka &apos;Subject Identifier for the Study (SUBJID)&apos; at CDICS, and &apos;subject identification&apos; at RPB.</rdfs:comment>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Subject Identifier</rdfs:label>
        <skos:altLabel>Studynumber</skos:altLabel>
        <skos:definition></skos:definition>
        <skos:definition>A sequence of characters used to identify, name, or characterize the study subject.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95085 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95085">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Body Weight Domain</rdfs:label>
        <skos:altLabel>Body Weight, BW</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to body weight.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95086 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95086">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Clinical Observation Domain</rdfs:label>
        <skos:altLabel>Clinical Observation, CL</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to clinical observations.</skos:definition>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95087 -->


    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95087">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/NCIT</rdfs:isDefinedBy>
        <rdfs:label>Death Diagnosis Domain</rdfs:label>
        <skos:altLabel>Death Diagnosis and Details, Death Details, DD</skos:altLabel>
        <skos:definition>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to death diagnosis.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T001 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T001">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T072"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Organism</rdfs:label>
        <skos:definition xml:lang="en">Generally, a living individual, including all plants and animals.</skos:definition>
        <skos:exactMatch>Thesaurus:C14250 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14250)</skos:exactMatch>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T002 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T002">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T204"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Plant</rdfs:label>
        <skos:definition xml:lang="en">An organism having cellulose cell walls, growing by synthesis of inorganic substances, generally distinguished by the presence of chlorophyll, and lacking the power of locomotion. Plant parts are included here as well.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T004 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T004">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T204"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Fungus</rdfs:label>
        <skos:definition xml:lang="en">A eukaryotic organism characterized by the absence of chlorophyll and the presence of a rigid cell wall. Included here are both slime molds and true fungi such as yeasts, molds, mildews, and mushrooms.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T005 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T005">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T001"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Virus</rdfs:label>
        <skos:definition xml:lang="en">An organism consisting of a core of a single nucleic acid enclosed in a protective coat of protein. A virus may replicate only inside a host living cell. A virus exhibits some but not all of the usual characteristics of living things.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T007 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T007">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T001"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Bacterium</rdfs:label>
        <skos:definition xml:lang="en">A small, typically one-celled, prokaryotic micro-organism.</skos:definition>
        <skos:exactMatch>Thesaurus:C14187 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14187)</skos:exactMatch>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T008 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T008">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T204"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Animal</rdfs:label>
        <skos:definition xml:lang="en">An organism with eukaryotic cells, and lacking stiff cell walls, plastids and photosynthetic pigments.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T010 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T010">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T008"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Vertebrate</rdfs:label>
        <skos:definition xml:lang="en">An animal which has a spinal column.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T011 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T011">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T010"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Amphibian</rdfs:label>
        <skos:definition xml:lang="en">A cold-blooded, smooth-skinned vertebrate which characteristically hatches as an aquatic larva, breathing by gills. When mature, the amphibian breathes with lungs.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T012 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T012">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T010"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Bird</rdfs:label>
        <skos:definition xml:lang="en">A vertebrate having a constant body temperature and characterized by the presence of feathers.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T013 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T013">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T010"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Fish</rdfs:label>
        <skos:definition xml:lang="en">A cold-blooded aquatic vertebrate characterized by fins and breathing by gills. Included here are fishes having either a bony skeleton, such as a perch, or a cartilaginous skeleton, such as a shark, or those lacking a jaw, such as a lamprey or hagfish.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T014 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T014">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T010"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Reptile</rdfs:label>
        <skos:definition xml:lang="en">A cold-blooded vertebrate having an external covering of scales or horny plates. Reptiles breathe by means of lungs and are generally egg-laying.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T015 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T015">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T010"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Mammal</rdfs:label>
        <skos:definition xml:lang="en">A vertebrate having a constant body temperature and characterized by the presence of hair, mammary glands and sweat glands.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T051 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T051">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Event</rdfs:label>
        <skos:definition xml:lang="en">A broad type for grouping activities, processes and states.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T052 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T052">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T051"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
        <skos:definition xml:lang="en">An operation or series of operations that an organism or machine carries out or participates in.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T067 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T067">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T051"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Phenomenon or Process</rdfs:label>
        <skos:definition xml:lang="en">A process or state which occurs naturally or as a result of an activity.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T071 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T071">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
        <skos:definition xml:lang="en">A broad type for grouping physical and conceptual entities.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T072 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T072">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T071"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Physical Object</rdfs:label>
        <skos:definition xml:lang="en">An object perceptible to the sense of vision or touch.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T077 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T077">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T071"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Conceptual Entity</rdfs:label>
        <skos:definition xml:lang="en">A broad type for grouping abstract entities or concepts.</skos:definition>
        <skos:exactMatch>Thesaurus:C20181 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C20181)</skos:exactMatch>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T170 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T170">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T077"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Intellectual Product</rdfs:label>
        <skos:definition xml:lang="en">A conceptual entity resulting from human endeavor. Concepts assigned to this type generally refer to information created by humans for some purpose.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T194 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T194">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T001"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Archaeon</rdfs:label>
        <skos:definition xml:lang="en">A member of one of the three domains of life, formerly called Archaebacteria under the taxon Bacteria, but now considered separate and distinct. Archaea are characterized by: 1) the presence of characteristic tRNAs and ribosomal RNAs; 2) the absence of peptidoglycan cell walls; 3) the presence of ether-linked lipids built from branched-chain subunits; and 4) their occurrence in unusual habitats. While archaea resemble bacteria in morphology and genomic organization, they resemble eukarya in their method of genomic replication.</skos:definition>
        <skos:exactMatch>Thesaurus:C61092 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C61092)</skos:exactMatch>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/STY/T204 -->


    <owl:Class rdf:about="http://purl.bioontology.org/ontology/STY/T204">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/STY/T001"/>
        <rdfs:isDefinedBy>http://purl.bioontology.org/ontology/STY</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Eukaryote</rdfs:label>
        <skos:definition xml:lang="en">One of the three domains of life (the others being Bacteria and Archaea), also called Eukarya. These are organisms whose cells are enclosed in membranes and possess a nucleus. They comprise almost all multicellular and many unicellular organisms, and are traditionally divided into groups (sometimes called kingdoms) including Animals, Plants, Fungi, various Algae, and other taxa that were previously part of the old kingdom Protista.</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->


    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing"/>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000006 -->


    <owl:Class rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000006">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25364"/>
        <dc:creator>Wahyu W. Hadiwikarta and Abumansur Sabyrrakhim</dc:creator>
        <rdfs:label>Animal Identifier</rdfs:label>
        <skos:definition>An identifier which is used to uniquely identify an animal in a certain context (cohort, hospital, trial). Can be a pseudonym.</skos:definition>
    </owl:Class>
    


