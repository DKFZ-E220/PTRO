    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000008 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000008">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Identifier</rdfs:label>
        <skos:altLabel>STUDYID</skos:altLabel>
        <skos:definition>Unique identifier for a study.</skos:definition>
        <skos:exactMatch>Thesaurus:C83082 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83082)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000009 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000009">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14238"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:comment>a.k.a &apos;Subject Id&apos; at RPB.</rdfs:comment>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Unique_Subject_Identifier</rdfs:label>
        <skos:altLabel>USUBJID</skos:altLabel>
        <skos:definition>Identifier used to uniquely identify a subject across all studies for all applications or submissions involving the product.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000010 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000010">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14238"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:comment>a.k.a &apos;subject identification&apos; at RPB.</rdfs:comment>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Subject_Identifier_for_the_Study</rdfs:label>
        <skos:altLabel>SUBJID</skos:altLabel>
        <skos:definition>Subject (i.e., Animal) identifier used within the study.</skos:definition>
        <skos:exactMatch>Thesaurus:C83083 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000011 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000011">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Route_of_Administration</rdfs:label>
        <skos:altLabel>EXROUTE</skos:altLabel>
        <skos:definition>Route of administration for EXTRT. Examples: ORAL GAVAGE, DERMAL, INTRAVENOUS.</skos:definition>
        <skos:exactMatch>Thesaurus:C83121 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83121)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000012 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000012">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Treatment_Vehicle</rdfs:label>
        <skos:altLabel>EXTRTV</skos:altLabel>
        <skos:definition>Describes vehicle used for treatment. Example: SALINE.</skos:definition>
        <skos:exactMatch>Thesaurus:C83292 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83292)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000013 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000013">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Name_of_Actual_Treatment</rdfs:label>
        <skos:altLabel>EXTRT</skos:altLabel>
        <skos:definition>Name of the treatment, as defined by the protocol.</skos:definition>
        <skos:exactMatch>Thesaurus:C83091 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83091)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000015 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000015">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Body_Weight_Test_Short_Name</rdfs:label>
        <skos:altLabel>BWTESTCD</skos:altLabel>
        <skos:definition>Short name of the measurement, test, or examination described in BWTEST. It can be used as a column name when converting a dataset from a vertical to a horizontal format. The value in BWTESTCD cannot be longer than 8 characters, nor can it start with a number (e.g., &quot;1TEST&quot; is not valid). BWTESTCD cannot contain characters other than letters, numbers, or underscores.</skos:definition>
        <skos:exactMatch>Thesaurus:C119795 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119795)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000016 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000016">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Body_Weight_Test_Name</rdfs:label>
        <skos:altLabel>BWTEST</skos:altLabel>
        <skos:definition>Long name for BWTESTCD. The value in BWTEST cannot be longer than 40 characters.</skos:definition>
        <skos:exactMatch>Thesaurus:C119794 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119794)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000017 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000017">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Body_Weight_Result_or_Findings_as_Collected</rdfs:label>
        <skos:altLabel>BWORRES</skos:altLabel>
        <skos:definition>Result of the measurement or finding as originally received or collected.</skos:definition>
        <skos:exactMatch>Thesaurus:C119785 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119785)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000018 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000018">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Day_Animal_Weighed</rdfs:label>
        <skos:altLabel>BWDY</skos:altLabel>
        <skos:definition>Study day of body weight collection, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C119782 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119782)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000019 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000019">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
