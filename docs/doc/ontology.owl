<?xml version="1.0"?>
<rdf:RDF xmlns="https://purls.helmholtz-metadaten.de/ptro/"
     xml:base="https://purls.helmholtz-metadaten.de/ptro/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:metadata="http://data.bioontology.org/metadata/">
    <owl:Ontology rdf:about="https://purls.helmholtz-metadaten.de/ptro/">
        <owl:versionIRI rdf:resource="https://purls.helmholtz-metadaten.de/ptro/2026-10-10"/>
        <dc:creator>DKFZ-E220</dc:creator>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <rdfs:comment>The Ontology for Preclinical Trials in Radiation Oncology (PTRO), is a domain-specific ontology designed to integrate SEND-standardized preclinical data using semantic web technologies. PTRO incorporates the Semantic Types Ontology (STY) as a framework for broad concept categorization.</rdfs:comment>
        <owl:versionInfo>0.2 alpha</owl:versionInfo>
    </owl:Ontology>
    


