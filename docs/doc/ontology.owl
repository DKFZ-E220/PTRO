        <rdfs:label>Visit_Number</rdfs:label>
        <skos:altLabel>VISITNUM</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000244 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000244">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Related_Domain_Abbreviation</rdfs:label>
        <skos:altLabel>RDOMAIN</skos:altLabel>
        <skos:definition>Domain abbreviation of the parent record(s). Null for comments collected as a general comment or additional information.</skos:definition>
        <skos:exactMatch>Thesaurus:C83391 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83391)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- 
