        <rdfs:label>Study_Day_of_Comment</rdfs:label>
        <skos:altLabel>CODY</skos:altLabel>
        <skos:definition>Study day of the comment, in integer days. May be null if this is a child record of another domain or if the comment date was not collected. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C119819 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119819)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000097 -->


