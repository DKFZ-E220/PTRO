        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Death_Diagnosis_Name</rdfs:label>
        <skos:altLabel>DDTEST</skos:altLabel>
        <skos:definition>Long name for DDTESTCD. The value in DDTEST cannot be longer than 40 characters.</skos:definition>
        <skos:exactMatch>Thesaurus:C89965 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C89965)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000021 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000021">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Death_Diagnosis_Result_Category</rdfs:label>
        <skos:altLabel>DDRESCAT</skos:altLabel>
        <skos:definition>Used to categorize the result of a finding. Examples: TREATMENT RELATED, NONTREATMENT RELATED, UNDETERMINED, ACCIDENTAL, etc.</skos:definition>
        <skos:exactMatch>Thesaurus:C102742 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102742)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000022 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000022">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Death_Diagnosis_Evaluator</rdfs:label>
        <skos:altLabel>DDEVAL</skos:altLabel>
        <skos:definition>Role of the person who provided the evaluation. Examples: TOX PATHOLOGIST, PEER REVIEW, SPONSOR, VETERINARIAN.</skos:definition>
        <skos:exactMatch>Thesaurus:C117548 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C117548)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000023 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000023">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:comment>a.k.a study day in CDISC</rdfs:comment>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_day_Animal_Death</rdfs:label>
        <skos:altLabel>DDDY</skos:altLabel>
        <skos:definition>Study day of subject disposition, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C117550 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C117550)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000028 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000028">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Clinical_Observations_Test_Short_Name</rdfs:label>
        <skos:altLabel>CLTESTCD</skos:altLabel>
        <skos:definition>Short name of the measurement, test, or examination described in CLTEST. It can be used as a column name when converting a dataset from a vertical to a horizontal format. The value in CLTESTCD cannot be longer than 8 characters, nor can it start with a number (e.g., &quot;1TEST&quot; is not valid). CLTESTCD cannot contain characters other than letters, numbers, or underscores.</skos:definition>
        <skos:exactMatch>Thesaurus:C119815 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119815)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000029 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000029">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Clinical_Observations_Test_Name</rdfs:label>
        <skos:altLabel>CLTEST</skos:altLabel>
        <skos:definition>Long name for CLTESTCD. The value in CLTEST cannot be longer than 40 characters.</skos:definition>
        <skos:exactMatch>Thesaurus:C119814 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119814)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000030 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000030">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Category_for_Clinical_Observations</rdfs:label>
        <skos:altLabel>CLCAT</skos:altLabel>
        <skos:definition>Used to define a category of the clinical observation.</skos:definition>
        <skos:exactMatch>Thesaurus:C119797 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119797)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000031 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000031">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Subcategory_for_Clinical_Observations</rdfs:label>
        <skos:altLabel>CLSCAT</skos:altLabel>
        <skos:definition>Used to further categorize a group of clinical observations within a category. For example &quot;Whole Body Appearance&quot; and &quot;Sensory Organ Appearance&quot; may be subcategories within Clinical Signs.</skos:definition>
        <skos:exactMatch>Thesaurus:C102740 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102740)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000033 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000033">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Age</rdfs:label>
        <skos:altLabel>AGE</skos:altLabel>
        <skos:definition>May be derived (RFSTDTC - BRTHDTC), but BRTHDTC may not be available in all cases. Age may also be collected.</skos:definition>
        <skos:exactMatch>Thesaurus:C25150 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25150)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000034 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000034">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Age_Unit</rdfs:label>
        <skos:altLabel>AGEU</skos:altLabel>
        <skos:definition>Units associated with AGE and AGETXT.</skos:definition>
        <skos:exactMatch>Thesaurus:C50400 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C50400)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000035 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000035">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Body_System_or_Organ_Class</rdfs:label>
        <skos:altLabel>CLBODSYS</skos:altLabel>
        <skos:definition>Body system or organ class associated with the measurement performed.</skos:definition>
        <skos:exactMatch>Thesaurus:C119796 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119796)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000036 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000036">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Clinical_Observations_Result_Category</rdfs:label>
        <skos:altLabel>CLRESCAT</skos:altLabel>
        <skos:definition>Used to categorize the result of a finding post collection. Examples: Color or Facial.</skos:definition>
        <skos:exactMatch>Thesaurus:C102741 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C102741)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000037 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000037">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Clinical_Observations_Completion_Status</rdfs:label>
        <skos:altLabel>CLSTAT</skos:altLabel>
        <skos:definition>Used to indicate examination not done or result is missing. Should be null if a result exists in CLORRES.</skos:definition>
        <skos:exactMatch>Thesaurus:C119812 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119812)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000038 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000038">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Clinical_Observations_Evaluator</rdfs:label>
        <skos:altLabel>CLEVAL</skos:altLabel>
        <skos:definition>Role of the person who provided the evaluation. Example: TOX TECHNICIAN, OPHTHALMOLOGIST, VETERINARIAN.</skos:definition>
        <skos:exactMatch>Thesaurus:C119801 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119801)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000039 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000039">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Day_of_Clinical_Observation</rdfs:label>
        <skos:altLabel>CLDY</skos:altLabel>
        <skos:definition>Study day of observation, in integer days. For measurements related to a continuous evaluation interval, CLDY can be used to indicate start day of that interval. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C119799 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119799)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000040 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000040">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Sex</rdfs:label>
        <skos:altLabel>SEX</skos:altLabel>
        <skos:definition>The sex of the subject.</skos:definition>
        <skos:exactMatch>Thesaurus:C28421 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C28421)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000041 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000041">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Strain_Substrain</rdfs:label>
        <skos:altLabel>STRAIN</skos:altLabel>
        <skos:definition>Used to identify the vendor-supplied strain, substrain, or breed designation for the test system under study. It may combine the background strain, substrain, and associated genetic modifications as supplied by the vendor (e.g., C57BL/6, A/J, B6.129-Pparg&lt;tm2Rev&gt;/J, FISCHER 344, SPRAGUE-DAWLEY IGS, WISTAR Kyoto, BEAGLE, CYNOMOLGUS, and CHIMPANZEE). The SEND Controlled Terminology codelist consists of commonly used wild type strains. It is extensible to accommodate strains not listed and genetically modified substrains. If this variable is excluded in the DM domain, the information must be present at a higher level (either Trial Sets or Trial Summary). Country of origin for non-human primates should not go into STRAIN. In general, details related to coat color (e.g., White and Red designations for New Zealand Rabbits) should not go into STRAIN.</skos:definition>
        <skos:exactMatch>Thesaurus:C96373 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C96373)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000042 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000042">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Domain_Abbreviation</rdfs:label>
        <skos:altLabel>DOMAIN</skos:altLabel>
        <skos:definition>Two-character abbreviation for the domain.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000043 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000043">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Age_Range</rdfs:label>
        <skos:altLabel>AGETXT</skos:altLabel>
        <skos:definition>Used when the age is a range and the exact birthdate is not known. This variable is a character field for the purposes of defining age ranges, e.g., if the information available for the age of the subject is 6-8 and AGEU is WEEKS. Populate only when BRTHDTC or AGE is not specified. The format for AGETXT is &quot;number-number&quot; (e.g., 6-8).</skos:definition>
        <skos:exactMatch>Thesaurus:C90352 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C90352)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000044 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000044">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Day_of_Start_of_Treatment</rdfs:label>
        <skos:altLabel>EXSTDY</skos:altLabel>
        <skos:definition>Study day when administration of the treatment began, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C83289 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83289)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000046 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000046">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:comment>a.k.a Unit of the Original Result in CDISC Data Standards Browser</rdfs:comment>
        <rdfs:label>Body_Weight_Unit_of_the_Original_Result</rdfs:label>
        <skos:altLabel>BWORRESU</skos:altLabel>
        <skos:definition>The unit for the original result. The unit of the original result should be mapped to a synonymous unit on the Controlled Terminology list.</skos:definition>
        <skos:exactMatch>Thesaurus:C119786 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119786)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000051 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000051">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:comment>Identifier used for pooling subjects to assign a single finding to multiple subjects.</rdfs:comment>
        <rdfs:label>Pool_Identifier</rdfs:label>
        <skos:altLabel>POOLID</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000053 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000053">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Exposure_Dose_per_Administration</rdfs:label>
        <skos:altLabel>EXDOSE</skos:altLabel>
        <skos:definition>Amount of treatment administered.</skos:definition>
        <skos:exactMatch>Thesaurus:C83039 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83039)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000054 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000054">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Exposure_Dose_Units</rdfs:label>
        <skos:altLabel>EXDOSU</skos:altLabel>
        <skos:definition>Units for EXDOSE or EXDOSTXT. Examples: ng, mg, or mg/kg.</skos:definition>
        <skos:exactMatch>Thesaurus:C83035 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83035)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000055 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000055">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Amount_Administered</rdfs:label>
        <skos:altLabel>EXVAMT</skos:altLabel>
        <skos:definition>The amount (volume or weight) of the treatment compound plus vehicle administered in a single dose. This is not to be confused with EXDOSE. EXDOSE refers to the amount of test material administered to the subject.</skos:definition>
        <skos:exactMatch>Thesaurus:C87883 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C87883)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000056 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000056">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Amount_Administered_Units</rdfs:label>
        <skos:altLabel>EXVAMTU</skos:altLabel>
        <skos:definition>Units for EXVAMT (per dose administration).</skos:definition>
        <skos:exactMatch>Thesaurus:C87884 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C87884)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000057 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000057">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Day_of_End_Date_of_Treatment</rdfs:label>
        <skos:altLabel>EXENDY</skos:altLabel>
        <skos:definition>Study day when administration of the treatment ended, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C83283 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83283)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000058 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000058">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Duration_of_Treatment</rdfs:label>
        <skos:altLabel>EXDUR</skos:altLabel>
        <skos:definition>Duration and unit of time for a continuous treatment. This may be used to denote the length of an infusion (e.g., PT10M to indicate 10 minutes).</skos:definition>
        <skos:exactMatch>Thesaurus:C83280 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83280)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000060 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000060">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Lab_Test_or_Examination_Short_Name</rdfs:label>
        <skos:altLabel>LBTESTCD</skos:altLabel>
        <skos:definition>Short name of the measurement, test, or examination described in LBTEST. It can be used as a column name when converting a dataset from a vertical to a horizontal format. The value in LBTESTCD cannot be longer than 8 characters, nor can it start with a number (e.g., &quot;1TEST&quot; is not valid). LBTESTCD cannot contain characters other than letters, numbers, or underscores. Examples: ALT, LDH.</skos:definition>
        <skos:exactMatch>Thesaurus:C83322 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83322)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000061 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000061">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Lab_Test_or_Examination_Name</rdfs:label>
        <skos:altLabel>LBTEST</skos:altLabel>
        <skos:definition>Long name for LBTESTCD. The value in LBTEST cannot be longer than 40 characters. Examples: Alanine Aminotransferase, Lactate Dehydrogenase.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000062 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000062">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Lab_Result_or_Findings_as_Collected</rdfs:label>
        <skos:altLabel>LBORRES</skos:altLabel>
        <skos:definition>Result of the measurement or finding as originally received or collected.</skos:definition>
        <skos:exactMatch>Thesaurus:C83165 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83165)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000063 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000063">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Lab_Unit_of_the_Original_Result</rdfs:label>
        <skos:altLabel>LBORRESU</skos:altLabel>
        <skos:definition>The unit for the original result. The unit of the original result should be mapped to a synonymous unit on the Controlled Terminology (http://www.cdisc.org/terminology) list.</skos:definition>
        <skos:exactMatch>Thesaurus:C83106 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83106)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000064 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000064">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Laboratory_Name</rdfs:label>
        <skos:altLabel>LBNAM</skos:altLabel>
        <skos:definition>Name or identifier of the laboratory or vendor that provided the test results.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000065 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000065">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Anatomical_Region_of_Specimen</rdfs:label>
        <skos:altLabel>LBANTREG</skos:altLabel>
        <skos:definition>Defines the specific anatomical or biological region of a tissue, organ specimen, or the region from which the specimen was obtained, such as a section or part of what is defined in the LBSPEC variable. If the anatomical region is not included in the specimen description LBSPEC, it may be included in this variable. This field can be a combination of terms where needed. This field can be null if not applicable. Examples: CORTEX, MEDULLA, MUCOSA, SEROSA, ISLET, ZONA FASICULATA, ZONA RETICULARIS, CRANIAL, MEDIAN, ACCESSORY, SPINAL, LUMBAR, FRONTAL.</skos:definition>
        <skos:exactMatch>Thesaurus:C119844 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119844)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000066 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000066">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Specimen_Condition</rdfs:label>
        <skos:altLabel>LBSPCCND</skos:altLabel>
        <skos:definition>Free or standardized text describing the condition of the specimen. Examples: HEMOLYZED, ICTERIC, LIPEMIC</skos:definition>
        <skos:exactMatch>Thesaurus:C83024 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83024)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000067 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000067">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Specimen_Usability_for_the_Test</rdfs:label>
        <skos:altLabel>LBSPCUFL</skos:altLabel>
        <skos:definition>Describes the usability of the specimen for the test. Should be N if the specimen is not usable; otherwise it should be null.</skos:definition>
        <skos:exactMatch>Thesaurus:C119852 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119852)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000068 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000068">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Lab_Portion_or_Totality</rdfs:label>
        <skos:altLabel>LBPORTOT</skos:altLabel>
        <skos:definition>Qualifier for anatomical location or specimen further detailing the portion or totality, which means arrangement of, or apportioning of. Examples: ENTIRE, SINGLE, SEGMENT, MANY.</skos:definition>
        <skos:exactMatch>Thesaurus:C119850 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119850)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000069 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000069">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Method_of_Test_or_Examination</rdfs:label>
        <skos:altLabel>LBMETHOD</skos:altLabel>
        <skos:definition>Method of the test or examination. Examples: EIA (Enzyme Immunoassay), ELECTROPHORESIS, DIPSTICK</skos:definition>
        <skos:exactMatch>Thesaurus:C83312 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83312)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000070 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000070">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Baseline_Flag</rdfs:label>
        <skos:altLabel>LBBLFL</skos:altLabel>
        <skos:definition>A baseline indicator may be used to calculate differences or changes from baseline. Value should be Y or null. The baseline flag is sponsor defined.</skos:definition>
        <skos:exactMatch>Thesaurus:C83303 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83303)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000071 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000071">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Day_of_Specimen_Collection</rdfs:label>
        <skos:altLabel>LBDY</skos:altLabel>
        <skos:definition>Study day of specimen collection, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C83306 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83306)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000072 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000072">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Study_Day_of_End_of_Specimen_Collection</rdfs:label>
        <skos:altLabel>LBENDY</skos:altLabel>
        <skos:definition>Study day of the end of specimen collection, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain.</skos:definition>
        <skos:exactMatch>Thesaurus:C119846 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119846)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000073 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000073">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Nominal_Study_Day_for_Tabulations</rdfs:label>
        <skos:altLabel>LBNOMDY</skos:altLabel>
        <skos:definition>Nominal study day used for grouping records for specimen collections that may occur on different days into a single reported study day. Should be an integer.</skos:definition>
        <skos:exactMatch>Thesaurus:C170498 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170498)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000074 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000074">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Laboratory_Label_for_Nominal_Study_Day</rdfs:label>
        <skos:altLabel>LBNOMLBL</skos:altLabel>
        <skos:definition>A label for a given value of LBNOMDY as presented in the study report. Examples: Week 4, Day 28, Terminal Sac.</skos:definition>
        <skos:exactMatch>Thesaurus:C170499 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170499)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000083 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000083">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:label>Body_Weight_Label_for_Nominal_Study_Day</rdfs:label>
        <skos:altLabel>BWNOMLBL</skos:altLabel>
        <skos:definition>A label for a given value of BWNOMDY as presented in the study report. Examples: &quot;Week 4,&quot; &quot;Day 28,&quot; &quot;Terminal Sac&quot;.</skos:definition>
        <skos:exactMatch>Thesaurus:C170499 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C170499)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000090 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000090">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Reported_Name_of_Procedure</rdfs:label>
        <skos:altLabel>PRTRT</skos:altLabel>
        <skos:definition>The literal identifier of the procedure.</skos:definition>
        <skos:exactMatch>Thesaurus:C117511 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C117511)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000091 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000091">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Identifying_Variable</rdfs:label>
        <skos:altLabel>IDVAR</skos:altLabel>
        <skos:definition>Variable in the parent dataset that identifies the record(s) to which the comment applies, which is contained in IDVAR. Examples: BWSEQ or CLGRPID. Used only when individual comments are related to domain records.</skos:definition>
        <skos:exactMatch>Thesaurus:C83293 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83293)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000092 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000092">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Identifying_Variable_Value</rdfs:label>
        <skos:altLabel>IDVARVAL</skos:altLabel>
        <skos:definition>Value of identifying variable of the parent record(s). Used only when individual comments are related to domain records. Cannot be populated if IDVAR is null.</skos:definition>
        <skos:exactMatch>Thesaurus:C83294 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83294)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000093 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000093">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Comment</rdfs:label>
        <skos:altLabel>COVAL</skos:altLabel>
        <skos:definition>The text of the comment. Text over 200 characters can be added to additional columns COVAL1-COVALn. See Assumption 4 in Section 5.2.1.1.</skos:definition>
        <skos:exactMatch>Thesaurus:C83241 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83241)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000094 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000094">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Comment_Evaluator</rdfs:label>
        <skos:altLabel>COEVAL</skos:altLabel>
        <skos:definition>Used to describe the originator of the comment. Examples: TECHNICIAN, STUDY DIRECTOR, VET.</skos:definition>
        <skos:exactMatch>Thesaurus:C83239 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83239)</skos:exactMatch>
    </owl:DatatypeProperty>
    


    <!-- https://purls.helmholtz-metadaten.de/ptro/DKFZ000095 -->


    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000095">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>OGiraldo</dc:creator>
        <rdfs:isDefinedBy>https://library.cdisc.org/browser</rdfs:isDefinedBy>
        <rdfs:label>Date_Time_of_Comment</rdfs:label>
        <skos:altLabel>CODTC</skos:altLabel>
        <skos:definition>Date/Time of the comment, in ISO 8601 format. May be null if this is a child record of another domain or if the comment date was not collected. In all other cases, this represents the date/time of the comment in ISO 8601 format.</skos:definition>
        <skos:exactMatch>Thesaurus:C83238 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83238)</skos:exactMatch>
    </owl:DatatypeProperty>
    


