    <owl:DatatypeProperty rdf:about="https://purls.helmholtz-metadaten.de/ptro/DKFZ000096">
        <rdfs:domain rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256"/>
