        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dc:creator>S.V.Ilango</dc:creator>
        <rdfs:comment>Date/Time of the reference time point, LBTPTREF.</rdfs:comment>
        <rdfs:label>Date_Time_of_Reference_Time_Point</rdfs:label>
        <skos:altLabel>LBRFTDTC</skos:altLabel>
    </owl:DatatypeProperty>
    


