###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663> ;
                                                            rdfs:comment "aka 'Unique Subject Identifier (USUBJID)' at CDISC; and 'Subject Id' at RPB." ;
                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
                                                            rdfs:label "Subject Unique Identifier" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A unique identifier for a subject in a study." .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25364> ;
                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
                                                            rdfs:label "Unique Identifier"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A set of characters used as a code that is unique in the context or the system for which it is created. It serves as a means of identification and reference (often instead of a name) for an entity, person, thing, function, procedure, activity, variable, or body of data."@en .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71160
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71160> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C70663> ;
                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
                                                            rdfs:label "Instance Unique Identifier"@en ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "Data type unique identifier within a particular context."@en .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> rdf:type owl:Class ;
