            rdfs:label "Date_Time" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "DDDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000166
:DKFZ000166 rdf:type owl:DatatypeProperty ;
