                                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Clinical Observation, CL" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to clinical observations." .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95087
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95087> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289> ;
                                                            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
                                                            rdfs:label "Death Diagnosis Domain" ;
                                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Death Diagnosis and Details, Death Details, DD" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to death diagnosis." .


###  http://purl.bioontology.org/ontology/STY/T001
<http://purl.bioontology.org/ontology/STY/T001> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T072> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Organism"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Generally, a living individual, including all plants and animals."@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C14250 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14250)" .


###  http://purl.bioontology.org/ontology/STY/T002
<http://purl.bioontology.org/ontology/STY/T002> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T204> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Plant"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An organism having cellulose cell walls, growing by synthesis of inorganic substances, generally distinguished by the presence of chlorophyll, and lacking the power of locomotion. Plant parts are included here as well."@en .


###  http://purl.bioontology.org/ontology/STY/T004
<http://purl.bioontology.org/ontology/STY/T004> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T204> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Fungus"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A eukaryotic organism characterized by the absence of chlorophyll and the presence of a rigid cell wall. Included here are both slime molds and true fungi such as yeasts, molds, mildews, and mushrooms."@en .


###  http://purl.bioontology.org/ontology/STY/T005
<http://purl.bioontology.org/ontology/STY/T005> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T001> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Virus"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An organism consisting of a core of a single nucleic acid enclosed in a protective coat of protein. A virus may replicate only inside a host living cell. A virus exhibits some but not all of the usual characteristics of living things."@en .


###  http://purl.bioontology.org/ontology/STY/T007
<http://purl.bioontology.org/ontology/STY/T007> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T001> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Bacterium"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A small, typically one-celled, prokaryotic micro-organism."@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C14187 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14187)" .


###  http://purl.bioontology.org/ontology/STY/T008
<http://purl.bioontology.org/ontology/STY/T008> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T204> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Animal"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An organism with eukaryotic cells, and lacking stiff cell walls, plastids and photosynthetic pigments."@en .


###  http://purl.bioontology.org/ontology/STY/T010
<http://purl.bioontology.org/ontology/STY/T010> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T008> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Vertebrate"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An animal which has a spinal column."@en .


###  http://purl.bioontology.org/ontology/STY/T011
<http://purl.bioontology.org/ontology/STY/T011> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T010> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Amphibian"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A cold-blooded, smooth-skinned vertebrate which characteristically hatches as an aquatic larva, breathing by gills. When mature, the amphibian breathes with lungs."@en .


###  http://purl.bioontology.org/ontology/STY/T012
<http://purl.bioontology.org/ontology/STY/T012> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T010> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Bird"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A vertebrate having a constant body temperature and characterized by the presence of feathers."@en .


###  http://purl.bioontology.org/ontology/STY/T013
<http://purl.bioontology.org/ontology/STY/T013> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T010> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Fish"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A cold-blooded aquatic vertebrate characterized by fins and breathing by gills. Included here are fishes having either a bony skeleton, such as a perch, or a cartilaginous skeleton, such as a shark, or those lacking a jaw, such as a lamprey or hagfish."@en .


###  http://purl.bioontology.org/ontology/STY/T014
<http://purl.bioontology.org/ontology/STY/T014> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T010> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Reptile"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A cold-blooded vertebrate having an external covering of scales or horny plates. Reptiles breathe by means of lungs and are generally egg-laying."@en .


###  http://purl.bioontology.org/ontology/STY/T015
<http://purl.bioontology.org/ontology/STY/T015> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T010> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Mammal"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A vertebrate having a constant body temperature and characterized by the presence of hair, mammary glands and sweat glands."@en .


###  http://purl.bioontology.org/ontology/STY/T051
<http://purl.bioontology.org/ontology/STY/T051> rdf:type owl:Class ;
                                                rdfs:subClassOf owl:Thing ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Event"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A broad type for grouping activities, processes and states."@en .


###  http://purl.bioontology.org/ontology/STY/T052
<http://purl.bioontology.org/ontology/STY/T052> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T051> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Activity"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An operation or series of operations that an organism or machine carries out or participates in."@en .


###  http://purl.bioontology.org/ontology/STY/T067
<http://purl.bioontology.org/ontology/STY/T067> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T051> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Phenomenon or Process"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A process or state which occurs naturally or as a result of an activity."@en .


###  http://purl.bioontology.org/ontology/STY/T071
<http://purl.bioontology.org/ontology/STY/T071> rdf:type owl:Class ;
                                                rdfs:subClassOf owl:Thing ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Entity"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A broad type for grouping physical and conceptual entities."@en .


###  http://purl.bioontology.org/ontology/STY/T072
<http://purl.bioontology.org/ontology/STY/T072> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T071> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Physical Object"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An object perceptible to the sense of vision or touch."@en .


###  http://purl.bioontology.org/ontology/STY/T077
<http://purl.bioontology.org/ontology/STY/T077> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T071> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Conceptual Entity"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A broad type for grouping abstract entities or concepts."@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C20181 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C20181)" .


###  http://purl.bioontology.org/ontology/STY/T170
<http://purl.bioontology.org/ontology/STY/T170> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T077> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Intellectual Product"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A conceptual entity resulting from human endeavor. Concepts assigned to this type generally refer to information created by humans for some purpose."@en .


###  http://purl.bioontology.org/ontology/STY/T194
<http://purl.bioontology.org/ontology/STY/T194> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T001> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Archaeon"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "A member of one of the three domains of life, formerly called Archaebacteria under the taxon Bacteria, but now considered separate and distinct. Archaea are characterized by: 1) the presence of characteristic tRNAs and ribosomal RNAs; 2) the absence of peptidoglycan cell walls; 3) the presence of ether-linked lipids built from branched-chain subunits; and 4) their occurrence in unusual habitats. While archaea resemble bacteria in morphology and genomic organization, they resemble eukarya in their method of genomic replication."@en ;
                                                <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C61092 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C61092)" .


###  http://purl.bioontology.org/ontology/STY/T204
<http://purl.bioontology.org/ontology/STY/T204> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.bioontology.org/ontology/STY/T001> ;
                                                rdfs:isDefinedBy "http://purl.bioontology.org/ontology/STY" ;
                                                rdfs:label "Eukaryote"@en ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "One of the three domains of life (the others being Bacteria and Archaea), also called Eukarya. These are organisms whose cells are enclosed in membranes and possess a nucleus. They comprise almost all multicellular and many unicellular organisms, and are traditionally divided into groups (sometimes called kingdoms) including Animals, Plants, Fungi, various Algae, and other taxa that were previously part of the old kingdom Protista."@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


