            rdfs:label "Standardized_Result_in_Numeric_Format" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "BWSTRESN" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000151
:DKFZ000151 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
