            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Clinical_Observations_Evaluator" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLEVAL" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Role of the person who provided the evaluation. Example: TOX TECHNICIAN, OPHTHALMOLOGIST, VETERINARIAN." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C119801 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119801)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000039
:DKFZ000039 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Study_Day_of_Clinical_Observation" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLDY" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Study day of observation, in integer days. For measurements related to a continuous evaluation interval, CLDY can be used to indicate start day of that interval. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C119799 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119799)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000040
:DKFZ000040 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:integer ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Sex" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "SEX" ;
            <http://www.w3.org/2004/02/skos/core#definition> "The sex of the subject." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C28421 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C28421)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000041
:DKFZ000041 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Strain_Substrain" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "STRAIN" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Used to identify the vendor-supplied strain, substrain, or breed designation for the test system under study. It may combine the background strain, substrain, and associated genetic modifications as supplied by the vendor (e.g., C57BL/6, A/J, B6.129-Pparg<tm2Rev>/J, FISCHER 344, SPRAGUE-DAWLEY IGS, WISTAR Kyoto, BEAGLE, CYNOMOLGUS, and CHIMPANZEE). The SEND Controlled Terminology codelist consists of commonly used wild type strains. It is extensible to accommodate strains not listed and genetically modified substrains. If this variable is excluded in the DM domain, the information must be present at a higher level (either Trial Sets or Trial Summary). Country of origin for non-human primates should not go into STRAIN. In general, details related to coat color (e.g., White and Red designations for New Zealand Rabbits) should not go into STRAIN." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C96373 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C96373)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000042
:DKFZ000042 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Domain_Abbreviation" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "DOMAIN" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Two-character abbreviation for the domain." .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000043
:DKFZ000043 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Age_Range" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "AGETXT" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Used when the age is a range and the exact birthdate is not known. This variable is a character field for the purposes of defining age ranges, e.g., if the information available for the age of the subject is 6-8 and AGEU is WEEKS. Populate only when BRTHDTC or AGE is not specified. The format for AGETXT is \"number-number\" (e.g., 6-8)." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C90352 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C90352)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000044
:DKFZ000044 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
