            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Exposure_Dose_Units" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXDOSU" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Units for EXDOSE or EXDOSTXT. Examples: ng, mg, or mg/kg." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83035 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83035)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000055
:DKFZ000055 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Amount_Administered" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXVAMT" ;
            <http://www.w3.org/2004/02/skos/core#definition> "The amount (volume or weight) of the treatment compound plus vehicle administered in a single dose. This is not to be confused with EXDOSE. EXDOSE refers to the amount of test material administered to the subject." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C87883 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C87883)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000056
:DKFZ000056 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Amount_Administered_Units" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXVAMTU" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Units for EXVAMT (per dose administration)." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C87884 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C87884)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000057
:DKFZ000057 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Study_Day_of_End_Date_of_Treatment" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXENDY" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Study day when administration of the treatment ended, in integer days. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83283 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83283)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000058
:DKFZ000058 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Duration_of_Treatment" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXDUR" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Duration and unit of time for a continuous treatment. This may be used to denote the length of an infusion (e.g., PT10M to indicate 10 minutes)." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83280 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83280)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000060
:DKFZ000060 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Lab_Test_or_Examination_Short_Name" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTESTCD" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Short name of the measurement, test, or examination described in LBTEST. It can be used as a column name when converting a dataset from a vertical to a horizontal format. The value in LBTESTCD cannot be longer than 8 characters, nor can it start with a number (e.g., \"1TEST\" is not valid). LBTESTCD cannot contain characters other than letters, numbers, or underscores. Examples: ALT, LDH." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83322 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83322)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000061
:DKFZ000061 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Lab_Test_or_Examination_Name" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTEST" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Long name for LBTESTCD. The value in LBTEST cannot be longer than 40 characters. Examples: Alanine Aminotransferase, Lactate Dehydrogenase." .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000062
:DKFZ000062 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Lab_Result_or_Findings_as_Collected" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBORRES" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Result of the measurement or finding as originally received or collected." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83165 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83165)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000063
:DKFZ000063 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
