            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "The sequence number must be unique for each record within a USUBJID or POOLID, whichever applies for the record." ;
            rdfs:label "Sequence_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLSEQ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000167
:DKFZ000167 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Used to tie together a block of related records in a single domain for a subject or pool. This is not the treatment group number." ;
            rdfs:label "Group_Identifier" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLGRPID" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000168
:DKFZ000168 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Mass identifier such as MASS 1 or MASS A. Used when the mass was discovered during the in-life phase and assigned a mass identifier. The mass identification should be unique within the subject, regardless of mass location" ;
            rdfs:label "Mass_Identifier" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLSPID" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000169
:DKFZ000169 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Text description of the finding as originally received or collected. If the examination was not performed on a particular body system, or at the subject level, then the value should be null, and NOT DONE should appear in CLSTAT." ;
            rdfs:label "Result_or_Findings_as_Collected" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLORRES" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000170
:DKFZ000170 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "The base finding from CLORRES without modifiers. If the examination was completed and there were no abnormal findings, the value must be NORMAL." ;
            rdfs:label "Standardized_Result_in_Character_Format" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLSTRESC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000171
:DKFZ000171 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Describes why CLSTAT is NOT DONE, such as SUBJECT MORIBUND." ;
            rdfs:label "Reason_Not_Done" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLREASND" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000172
:DKFZ000172 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Can be used to specify where a clinical sign occurred. Example: LEFT EAR for skin rash." ;
            rdfs:label "Location_of_a_Finding" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLLOC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000173
:DKFZ000173 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Describes the severity or intensity of a particular finding." ;
            rdfs:label "Severity" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLSEV" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000174
:DKFZ000174 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Y if the result should be excluded from all calculations, otherwise null." ;
            rdfs:label "Exclusion_Flag" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLEXCLFL" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000175
:DKFZ000175 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "The reason the result should be excluded from all calculations. Used only when CLEXCLFL is Y." ;
            rdfs:label "Reason_for_Exclusion" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLREASEX" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000176
:DKFZ000176 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Indicates whether the timing of a performed test or observation was unscheduled. If a test or observation was performed based upon a schedule defined in the protocol, this flag should be null. Expected values are Y or null." ;
            rdfs:label "Unscheduled_Flag" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLUSCHFL" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000177
:DKFZ000177 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time of the clinical observation in ISO 8601 format. For measurements related to a continuous evaluation interval, CLDTC should be used to indicate the start date/time of that interval." ;
            rdfs:label "Date_Time_of_Observation" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000178
:DKFZ000178 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time of end of observation interval, in ISO 8601 format. Should be populated when CLDTC represents the start date/time of a continuous evaluation interval." ;
            rdfs:label "End_Date_Time_of_Observation" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLENDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000179
:DKFZ000179 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Study day of the end of observation, in integer days. Can be populated when CLDY represents the start day of a continuous evaluation interval. The algorithm for calculations must be relative to the sponsor-defined RFSTDTC variable in the Demographics (DM) domain." ;
            rdfs:label "Study_Day_of_End_of_Observation" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLENDY" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000180
:DKFZ000180 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Nominal study day used for grouping records for observations that may occur on different days into a single reported study day. Should be an integer." ;
            rdfs:label "Nominal_Study_Day_for_Tabulations" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLNOMDY" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000181
:DKFZ000181 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "A label for a given value of CLNOMDY as presented in the study report. Examples: Week 4, Day 28, Terminal Sac." ;
            rdfs:label "Label_for_Nominal_Study_Day" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLNOMLBL" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000182
:DKFZ000182 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Text description of time when an observation should be taken, as defined in the protocol. This may be represented as an elapsed time relative to a fixed reference point, such as time postdose." ;
            rdfs:label "Planned_Time_Point_Name" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLTPT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000183
:DKFZ000183 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Numerical version of CLTPT to aid in sorting." ;
            rdfs:label "Planned_Time_Point_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLTPTNUM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000184
:DKFZ000184 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Planned Elapsed time (in ISO 8601 format) relative to a planned reference (CLTPTREF). This variable is useful where there are repetitive measures. Not a clock time or a date time variable. Represented as an ISO 8601 duration. Examples: -PT15M to represent the period of 15 minutes prior to the reference point indicated by CLTPTREF, or PT8H to represent the period of 8 hours after the reference point indicated by CLTPTREF." ;
            rdfs:label "Planned_Elapsed_Time_from_Time_Point_Ref" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLELTM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000185
:DKFZ000185 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Name of the fixed reference point referred to by CLELTM, if used for CLTPTNUM, and CLTPT. It is recommended that CLTPTREF be as descriptive as possible, so the reference time point can be inferred without looking at other variables. Examples: PREVIOUS DOSE, PREVIOUS MEAL." ;
            rdfs:label "Time_Point_Reference" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLTPTREF" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000186
:DKFZ000186 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time of the reference time point, CLTPTREF." ;
            rdfs:label "Date_Time_of_Reference_Time_Point" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "CLRFTDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000187
:DKFZ000187 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "The sequence number must be unique for each record within a USUBJID or POOLID, whichever applies for the record." ;
            rdfs:label "Sequence_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSEQ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000188
:DKFZ000188 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Used to tie together a block of related records in a single domain for a subject or pool. This is not the treatment group number." ;
            rdfs:label "Group_Identifier" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBGRPID" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000189
:DKFZ000189 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Internal or external specimen identifier. Example: 1009570101." ;
            rdfs:label "Specimen_Identifier" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBREFID" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000190
:DKFZ000190 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Sponsor-defined reference identifier. Example: Line number on the Lab page." ;
            rdfs:label "Sponsor-Defined_Identifier" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSPID" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000191
:DKFZ000191 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Used to define a category of the lab test performed. Examples: URINALYSIS, CLINICAL CHEMISTRY, HEMATOLOGY, etc." ;
            rdfs:label "Category_for_Lab_Test" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBCAT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000192
:DKFZ000192 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "A further categorization of a test category. Examples: DIFFERENTIAL, LIVER FUNCTION, ELECTROLYTES." ;
            rdfs:label "Subcategory_for_Lab_Test" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSCAT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000193
:DKFZ000193 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Lower end of reference range used at the time of collection for continuous measurements in original units. Should be populated only for continuous results." ;
            rdfs:label "Reference_Range_Lower_Limit-Orig_Unit" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBORNRLO" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000194
:DKFZ000194 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Upper end of reference range used at the time of collection for continuous measurements in original units. Should be populated only for continuous results." ;
            rdfs:label "Reference_Range_Upper_Limit-Orig_Unit" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBORNRHI" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000195
:DKFZ000195 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Contains the result value for all findings, copied or derived from LBORRES, in a standard format or standard units. LBSTRESC should store all results or findings in character format; if results are numeric, they should also be submitted in numeric format in LBSTRESN. For example, if a test has results NONE, NEG, and NEGATIVE in LBORRES and these results effectively have the same meaning, they could be represented in standard format in LBSTRESC as NEGATIVE. For other examples, see general assumptions." ;
            rdfs:label "Standardized_Result_in_Character_Format" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTRESC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000196
:DKFZ000196 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Used for numeric results or findings in standard format; contains the numeric form of LBSTRESC. LBSTRESN should store all numeric test results or findings." ;
            rdfs:label "Standardized_Result_in_Numeric_Format" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTRESN" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000197
:DKFZ000197 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Standardized unit used for LBSTRESC and LBSTRESN." ;
            rdfs:label "Unit_of_the_Standardized_Result" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTRESU" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000198
:DKFZ000198 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Lower end of reference range for continuous measurements in standardized units. Should be populated only for continuous results." ;
            rdfs:label "Reference_Range_Lower_Limit-Std_Unit" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTNRLO" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000199
:DKFZ000199 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Upper end of reference range for continuous measurements in standardized units. Should be populated only for continuous results." ;
            rdfs:label "Reference_Range_Upper_Limit-Std_Unit" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTNRHI" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000200
:DKFZ000200 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "For normal range values that are character in ordinal scale or if categorical ranges were supplied (e.g., -1 to +1; NEGATIVE TO TRACE)." ;
            rdfs:label "Reference_Range_for_Char_Rslt-Std_Unit" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTNRC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000201
:DKFZ000201 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Indicates where value falls with respect to reference range defined by LBORNRLO and LBORNRHI, LBSTNRLO and LBSTNRHI, or by LBSTNRC. Examples: NORMAL, ABNORMAL, HIGH, LOW. Sponsors should specify in the study metadata (Comments column in the data definition file) whether LBNRIND refers to the original or standard reference ranges and results. Should not be used to indicate biological significance." ;
            rdfs:label "Reference_Range_Indicator" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBNRIND" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000202
:DKFZ000202 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Used to indicate when a test is not done or result is missing. Should be null if a result exists in LBORRES." ;
            rdfs:label "Completion_Status" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSTAT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000203
:DKFZ000203 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Describes why LBSTAT is NOT DONE, such as BROKEN EQUIPMENT or SPECIMEN LOST." ;
            rdfs:label "Reason_Not_Done" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBREASND" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000204
:DKFZ000204 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Defines the type of specimen analyzed to obtain the measurement or finding. Examples: WHOLE BLOOD, SERUM, PLASMA, URINE, LIVER, HEART." ;
            rdfs:label "Specimen_Material_Type" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSPEC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000205
:DKFZ000205 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Location relevant to the collection of specimen for the measurement." ;
            rdfs:label "Specimen_Collection_Location" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBLOC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000206
:DKFZ000206 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Qualifier for laterality of the specimen within the subject for paired specimens. Examples: LEFT, RIGHT, BILATERAL." ;
            rdfs:label "Specimen_Laterality_within_Subject" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBLAT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000207
:DKFZ000207 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Qualifier for directionality of the specimen within the subject. Examples: DORSAL, PROXIMAL." ;
            rdfs:label "Specimen_Directionality_within_Subject" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBDIR" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000208
:DKFZ000208 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Indicator used to identify fasting status. The value should be Y or null." ;
            rdfs:label "Fasting_Status" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBFAST" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000209
:DKFZ000209 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Used to indicate a derived record. The value should be Y or null. Records that represent the average of other records, or are not as originally received or collected, are examples of records that might be derived for the submission datasets." ;
            rdfs:label "Derived_Flag" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBDRVFL" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000210
:DKFZ000210 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Description of toxicity quantified by LBTOXGR. The sponsor is expected to provide the name and version of the scale used to map the terms, utilizing the data definition file external codelist attributes." ;
            rdfs:label "Toxicity" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTOX" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000211
:DKFZ000211 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Records toxicity grade value using a standard toxicity scale (such as the NCI CTCAE). If value is from a numeric scale, represent only the number (e.g., \"2\" and not \"Grade 2\"). The sponsor is expected to provide the name of the scale and version used to map the terms, utilizing the data definition file external codelist attributes." ;
            rdfs:label "Standard_Toxicity_Grade" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTOXGR" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000212
:DKFZ000212 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Y if the result should be excluded from all calculations, otherwise null." ;
            rdfs:label "Exclusion_Flag" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBEXCLFL" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000213
:DKFZ000213 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "The reason the result should be excluded from all calculations. Used only when LBEXCLFL is Y." ;
            rdfs:label "Reason_for_Exclusion" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBREASEX" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000214
:DKFZ000214 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Indicates whether the timing of the specimen collection was unscheduled. If a specimen collection was performed based upon a schedule defined in the protocol, this flag should be null. Expected values are Y or null." ;
            rdfs:label "Unscheduled_Flag" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBUSCHFL" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000215
:DKFZ000215 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time of specimen collection, in ISO 8601 format." ;
            rdfs:label "Date_Time_of_Specimen_Collection" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000216
:DKFZ000216 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time of the end of specimen collection in ISO 8601 format. Should be populated only for continuous sample collection." ;
            rdfs:label "End_Date_Time_of_Specimen_Collection" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBENDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000217
:DKFZ000217 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Text Description of time when specimen should be taken. This may be represented as an elapsed time relative to a fixed reference point, such as time of last dose. See LBTPTNUM and LBTPTREF. Examples: Start, 5 min post." ;
            rdfs:label "Planned_Time_Point_Name" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTPT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000218
:DKFZ000218 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Numerical version of LBTPT to aid in sorting." ;
            rdfs:label "Planned_Time_Point_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTPTNUM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000219
:DKFZ000219 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Elapsed time (in ISO 8601 format) relative to a planned fixed reference (LBTPTREF). This variable is useful where there are repetitive measures. Not a clock time or a date time variable. Represented as an ISO 8601 duration. Examples: -P15M to represent the period of 15 minutes prior to the reference point indicated by LBTPTREF, or P8H to represent the period of 8 hours after the reference point indicated by LBTPTREF." ;
            rdfs:label "Planned_Elapsed_Time_from_Time_Point_Ref" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBELTM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000220
:DKFZ000220 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Name of the fixed reference point referred to by LBELTM, if used for LBTPTNUM, and LBTPT. It is recommended that LBTPTREF be as descriptive as possible so the reference time point can be inferred without looking at other variables. Examples: PREVIOUS DOSE, PREVIOUS MEAL." ;
            rdfs:label "Time_Point_Reference" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBTPTREF" .


