            rdfs:label "Date_Time_of_Birth" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "BIRTHDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000128
:DKFZ000128 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:label "Species" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "SPECIES" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000129
:DKFZ000129 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Free-text field that allows the sponsor to enter further details qualifiying the SPECIES and/or STRAIN, depending on the level to which these variables were defined. Examples include the description of a specific genetic alteration, country of origin for non-human primates, details related to coat color (e.g., White and Red designations for New Zealand Rabbits), and important animal husbandry information (e.g., SPF, BR, VAF)." ;
            rdfs:label "Strain_Substrain_Details" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "SBSTRAIN" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000130
:DKFZ000130 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "The sequence number must be unique for each record with a USUBJID or POOLID" ;
            rdfs:label "Sequence_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXSEQ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000131
:DKFZ000131 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Identification of focus of study-specific interest on or withina subject or specimen as defined in protocol." ;
            rdfs:label "Focus_Of_Study_Specific_Interest" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "FOCID" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000132
:DKFZ000132 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "If the amount of treatment administered cannot be represented as a number and populated in EXDOSE, this field is used to describe the amount of treatment administered. Example: 200-400." ;
            rdfs:label "Dose_Description" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXDOSTXT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000133
:DKFZ000133 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Dose form of treatment." ;
            rdfs:label "Dose_Form" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXDOSFRM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000134
:DKFZ000134 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Usually expressed as the number of repeated administrations of EXDOSE within a specific time period." ;
            rdfs:label "Dosing_Frequency_Per_Interval" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXDOSFRQ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000135
:DKFZ000135 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Lot Number(s) or Batch Number(s) of the EXTRT test article. If mixed lots of the test article are administered during the same constant dosing interval, this should be represented as \"Lot A;Lot B.\" Mixed lots are produced by the mixing of Lots a and B of the test article into one solution." ;
            rdfs:label "Lot_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXLOT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000136
:DKFZ000136 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Specifies anatomical location (site) of administration. Example: LEFT HINDLIMB for a topical application or an injection site number. Each administration will require its own record." ;
            rdfs:label "Location_Of_Dose_Administration" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXLOC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000137
:DKFZ000137 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "EXMETHOD" ,
                                                      "S.V.Ilango" ;
            rdfs:comment "Method of dose administration." ;
            rdfs:label "Method_Of_Administration" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000138
:DKFZ000138 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Describes reason or explanation of why a dose is adjusted – used only when an adjustment is represented in EX. May be used for variations from protocol-specified doses or changes from expected doses (e.g., when dose is adjusted due to toxicity)." ;
            rdfs:label "Reason_For_Dose_Adjustment" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXADJ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000139
:DKFZ000139 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time when administration of the treatment indicated by EXTRT and EXDOSE began, in ISO 8601 format." ;
            rdfs:label "Start_Date_Time_Of_Treatment" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXSTDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000140
:DKFZ000140 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time when administration of the treatment indicated by EXTRT and EXDOSE ended, in ISO 8601 format." ;
            rdfs:label "End_Date_Time_Of_Char_Treatment" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXENDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000141
:DKFZ000141 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Text description of time when a dose should be given. Note: This may be represented as an elapsed time relative to a fixed reference point, such as time of last dose. See EXTPTNUM and EXTPTREF." ;
            rdfs:label "Planned_Time_Point_Name" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXTPT" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000142
:DKFZ000142 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Numerical version of EXTPT to aid in sorting." ;
            rdfs:label "Planned_Time_Point_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXTPTNUM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000143
:DKFZ000143 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Planned elapsed time (in ISO 8601 format) relative to the planned fixed reference (EXTPTREF). This variable is useful where there are repetitive measures. Not a clock time or a date time variable. Represented as an ISO 8601 duration. Examples: \"- PT15M\" to represent the period of 15 minutes prior to the reference point indicated by EXTPTREF, or \"PT8H\" to represent the period of 8 hours after the reference point indicated by EXTPTREF." ;
            rdfs:label "Planned_Elapsed_Time_From_Time_Point_Ref" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXELTM" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000144
:DKFZ000144 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Name of the fixed reference point referred to by EXELTM, if used for EXTPTNUM, and EXTPT. It is recommended that EXTPTREF be as descriptive as possible so the reference time point can be inferred without looking at other variables. Examples: Previous dose, previous feed." ;
            rdfs:label "Time_Point_Reference" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXTPTREF" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000145
:DKFZ000145 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:dateTime ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Date/Time of the reference time point, EXTPTREF" ;
            rdfs:label "Date_Time_Of_Reference_Time_Point" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "EXRFTDTC" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000146
:DKFZ000146 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.ILANGO" ;
            rdfs:comment "The sequence number must be unique for each record within a USUBJID or POOLID, whichever applies for the record." ;
            rdfs:label "Sequence_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "COSEQ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000147
:DKFZ000147 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "COREF" ,
                                                      "S.V.ILANGO" ;
            rdfs:comment "Sponsor-defined reference associated with the comment. May be the logbook page number, name (e.g., Logbook), or a combination of information that identifies the reference (e.g., Logbook, page 650, Day 28, morning)." ;
            rdfs:label "Comment_Reference" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000148
:DKFZ000148 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Sequence number given to ensure uniqueness of subject records within a domain. May be any valid number." ;
            rdfs:label "Sequence_Number" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "BWSEQ" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000149
:DKFZ000149 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
            rdfs:comment "Contains the result value for all findings, copied or derived from BWORRES in a standard format or standard units. BWSTRESC should store all results or findings in character format; if results are numeric, they should also be submitted in numeric format in BWSTRESN." ;
            rdfs:label "Standardized_Result_in_Character_Format" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "BWSTRESC" .


