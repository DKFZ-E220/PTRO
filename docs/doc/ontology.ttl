                                                            rdfs:comment "aka 'Subject Identifier for the Study (SUBJID)' at CDICS, and 'subject identification' at RPB." ;
                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
                                                            rdfs:label "Subject Identifier" ;
                                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Studynumber" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "" ,
                                                                                                             "A sequence of characters used to identify, name, or characterize the study subject." .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95085
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95085> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289> ;
