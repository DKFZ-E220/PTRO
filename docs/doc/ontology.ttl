                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
                                                            rdfs:label "Domain" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "An area of knowledge considered as a discrete unit for some purpose." .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69219
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69219> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71160> ;
