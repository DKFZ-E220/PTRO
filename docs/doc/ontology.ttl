            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSPCUFL" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Describes the usability of the specimen for the test. Should be N if the specimen is not usable; otherwise it should be null." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C119852 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119852)" .


