###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000122
:DKFZ000122 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
