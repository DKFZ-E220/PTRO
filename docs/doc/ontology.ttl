            <http://www.w3.org/2004/02/skos/core#altLabel> "RFXSTDTC" ;
            <http://www.w3.org/2004/02/skos/core#definition> "First date/time of exposure to any protocol-specified treatment or therapy, equal to the earliest value of EXSTDTC. Note: Absolute first." .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000125
:DKFZ000125 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:dateTime ;
            rdfs:label "Date_Time_of_Last_Study_Treatment" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "RFXENDTC" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Last date/time of exposure to any protocol-specified treatment or therapy, equal to the latest value of EXENDTC (or the latest value of EXSTDTC if EXENDTC was not collected or is missing)." .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000126
:DKFZ000126 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
