            <http://www.w3.org/2004/02/skos/core#altLabel> "CLSTAT" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Used to indicate examination not done or result is missing. Should be null if a result exists in CLORRES." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C119812 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119812)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000038
:DKFZ000038 rdf:type owl:DatatypeProperty ;
