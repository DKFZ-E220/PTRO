:DKFZ000150 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:decimal ;
            <http://purl.org/dc/elements/1.1/creator> "S.V.Ilango" ;
