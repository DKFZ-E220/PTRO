            <http://www.w3.org/2004/02/skos/core#altLabel> "LBORRESU" ;
            <http://www.w3.org/2004/02/skos/core#definition> "The unit for the original result. The unit of the original result should be mapped to a synonymous unit on the Controlled Terminology (http://www.cdisc.org/terminology) list." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83106 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83106)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000064
:DKFZ000064 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Laboratory_Name" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBNAM" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Name or identifier of the laboratory or vendor that provided the test results." .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000065
:DKFZ000065 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Anatomical_Region_of_Specimen" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBANTREG" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Defines the specific anatomical or biological region of a tissue, organ specimen, or the region from which the specimen was obtained, such as a section or part of what is defined in the LBSPEC variable. If the anatomical region is not included in the specimen description LBSPEC, it may be included in this variable. This field can be a combination of terms where needed. This field can be null if not applicable. Examples: CORTEX, MEDULLA, MUCOSA, SEROSA, ISLET, ZONA FASICULATA, ZONA RETICULARIS, CRANIAL, MEDIAN, ACCESSORY, SPINAL, LUMBAR, FRONTAL." ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C119844 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119844)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000066
:DKFZ000066 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C69256> ;
            rdfs:range xsd:string ;
            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
            rdfs:isDefinedBy "https://library.cdisc.org/browser" ;
            rdfs:label "Specimen_Condition" ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LBSPCCND" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Free or standardized text describing the condition of the specimen. Examples: HEMOLYZED, ICTERIC, LIPEMIC" ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "Thesaurus:C83024 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83024)" .


###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000067
