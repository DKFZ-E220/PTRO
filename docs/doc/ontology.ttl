                                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Body Weight, BW" ;
                                                            <http://www.w3.org/2004/02/skos/core#definition> "A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to body weight." .


###  http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95086
<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95086> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62289> ;
                                                            <http://purl.org/dc/elements/1.1/creator> "OGiraldo" ;
                                                            rdfs:isDefinedBy "http://purl.bioontology.org/ontology/NCIT" ;
