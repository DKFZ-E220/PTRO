###  https://purls.helmholtz-metadaten.de/ptro/DKFZ000164
:DKFZ000164 rdf:type owl:DatatypeProperty ;
            rdfs:domain <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C83083> ;
            rdfs:range xsd:string ;
