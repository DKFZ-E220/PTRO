    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000172</IRI>
        <Literal>Location_of_a_Finding</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
