        <AbbreviatedIRI>ncit:C69256</AbbreviatedIRI>
        <Literal>A unique identifier for a subject in a study.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>ncit:C70663</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/NCIT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ncit:C70663</AbbreviatedIRI>
        <Literal xml:lang="en">Unique Identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>ncit:C70663</AbbreviatedIRI>
        <Literal xml:lang="en">A set of characters used as a code that is unique in the context or the system for which it is created. It serves as a means of identification and reference (often instead of a name) for an entity, person, thing, function, procedure, activity, variable, or body of data.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>ncit:C71160</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/NCIT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ncit:C71160</AbbreviatedIRI>
        <Literal xml:lang="en">Instance Unique Identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>ncit:C71160</AbbreviatedIRI>
        <Literal xml:lang="en">Data type unique identifier within a particular context.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>ncit:C83083</AbbreviatedIRI>
        <Literal>aka &apos;Subject Identifier for the Study (SUBJID)&apos; at CDICS, and &apos;subject identification&apos; at RPB.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
