        <Literal>Describes the severity or intensity of a particular finding.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000173</IRI>
        <Literal>Severity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
