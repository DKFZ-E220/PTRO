        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000150</IRI>
        <Literal>Used for numeric results or findings in standard format; contains the numeric form of BWSTRESC. BWSTRESN should store all numeric test results or findings.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000150</IRI>
        <Literal>Standardized_Result_in_Numeric_Format</Literal>
    </AnnotationAssertion>
