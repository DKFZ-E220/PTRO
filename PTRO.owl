        <Literal>LBSPEC</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <IRI>DKFZ000205</IRI>
        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000205</IRI>
        <Literal>Location relevant to the collection of specimen for the measurement.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000205</IRI>
        <Literal>Specimen_Collection_Location</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <IRI>DKFZ000205</IRI>
        <Literal>LBLOC</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <IRI>DKFZ000206</IRI>
        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000206</IRI>
        <Literal>Qualifier for laterality of the specimen within the subject for paired specimens. Examples: LEFT, RIGHT, BILATERAL.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000206</IRI>
        <Literal>Specimen_Laterality_within_Subject</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <IRI>DKFZ000206</IRI>
        <Literal>LBLAT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <IRI>DKFZ000207</IRI>
        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000207</IRI>
        <Literal>Qualifier for directionality of the specimen within the subject. Examples: DORSAL, PROXIMAL.</Literal>
    </AnnotationAssertion>
