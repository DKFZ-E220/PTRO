        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000193</IRI>
        <Literal>Lower end of reference range used at the time of collection for continuous measurements in original units. Should be populated only for continuous results.</Literal>
    </AnnotationAssertion>
