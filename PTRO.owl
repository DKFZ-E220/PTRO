        <AbbreviatedIRI>ncit:C95086</AbbreviatedIRI>
        <Literal>Clinical Observation, CL</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>ncit:C95086</AbbreviatedIRI>
        <Literal>A subject domain utilized for the submission of information encompassing and representing data, vocabulary or records related to clinical observations.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
