        <IRI>DKFZ000200</IRI>
        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000200</IRI>
        <Literal>For normal range values that are character in ordinal scale or if categorical ranges were supplied (e.g., -1 to +1; NEGATIVE TO TRACE).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000200</IRI>
        <Literal>Reference_Range_for_Char_Rslt-Std_Unit</Literal>
    </AnnotationAssertion>
