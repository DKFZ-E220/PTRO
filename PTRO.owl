    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000192</IRI>
        <Literal>A further categorization of a test category. Examples: DIFFERENTIAL, LIVER FUNCTION, ELECTROLYTES.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000192</IRI>
        <Literal>Subcategory_for_Lab_Test</Literal>
