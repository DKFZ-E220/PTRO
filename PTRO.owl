    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T001</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T001</AbbreviatedIRI>
        <Literal xml:lang="en">Organism</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T001</AbbreviatedIRI>
        <Literal xml:lang="en">Generally, a living individual, including all plants and animals.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:exactMatch"/>
        <AbbreviatedIRI>sty:T001</AbbreviatedIRI>
        <Literal>Thesaurus:C14250 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14250)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T002</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T002</AbbreviatedIRI>
        <Literal xml:lang="en">Plant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T002</AbbreviatedIRI>
        <Literal xml:lang="en">An organism having cellulose cell walls, growing by synthesis of inorganic substances, generally distinguished by the presence of chlorophyll, and lacking the power of locomotion. Plant parts are included here as well.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T004</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T004</AbbreviatedIRI>
        <Literal xml:lang="en">Fungus</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T004</AbbreviatedIRI>
        <Literal xml:lang="en">A eukaryotic organism characterized by the absence of chlorophyll and the presence of a rigid cell wall. Included here are both slime molds and true fungi such as yeasts, molds, mildews, and mushrooms.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T005</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T005</AbbreviatedIRI>
        <Literal xml:lang="en">Virus</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T005</AbbreviatedIRI>
        <Literal xml:lang="en">An organism consisting of a core of a single nucleic acid enclosed in a protective coat of protein. A virus may replicate only inside a host living cell. A virus exhibits some but not all of the usual characteristics of living things.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T007</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T007</AbbreviatedIRI>
        <Literal xml:lang="en">Bacterium</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T007</AbbreviatedIRI>
        <Literal xml:lang="en">A small, typically one-celled, prokaryotic micro-organism.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:exactMatch"/>
        <AbbreviatedIRI>sty:T007</AbbreviatedIRI>
        <Literal>Thesaurus:C14187 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14187)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T008</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T008</AbbreviatedIRI>
        <Literal xml:lang="en">Animal</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T008</AbbreviatedIRI>
        <Literal xml:lang="en">An organism with eukaryotic cells, and lacking stiff cell walls, plastids and photosynthetic pigments.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T010</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T010</AbbreviatedIRI>
        <Literal xml:lang="en">Vertebrate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T010</AbbreviatedIRI>
        <Literal xml:lang="en">An animal which has a spinal column.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T011</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T011</AbbreviatedIRI>
        <Literal xml:lang="en">Amphibian</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T011</AbbreviatedIRI>
        <Literal xml:lang="en">A cold-blooded, smooth-skinned vertebrate which characteristically hatches as an aquatic larva, breathing by gills. When mature, the amphibian breathes with lungs.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T012</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T012</AbbreviatedIRI>
        <Literal xml:lang="en">Bird</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T012</AbbreviatedIRI>
        <Literal xml:lang="en">A vertebrate having a constant body temperature and characterized by the presence of feathers.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T013</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T013</AbbreviatedIRI>
        <Literal xml:lang="en">Fish</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T013</AbbreviatedIRI>
        <Literal xml:lang="en">A cold-blooded aquatic vertebrate characterized by fins and breathing by gills. Included here are fishes having either a bony skeleton, such as a perch, or a cartilaginous skeleton, such as a shark, or those lacking a jaw, such as a lamprey or hagfish.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T014</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T014</AbbreviatedIRI>
        <Literal xml:lang="en">Reptile</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T014</AbbreviatedIRI>
        <Literal xml:lang="en">A cold-blooded vertebrate having an external covering of scales or horny plates. Reptiles breathe by means of lungs and are generally egg-laying.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T015</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T015</AbbreviatedIRI>
        <Literal xml:lang="en">Mammal</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T015</AbbreviatedIRI>
        <Literal xml:lang="en">A vertebrate having a constant body temperature and characterized by the presence of hair, mammary glands and sweat glands.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T051</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T051</AbbreviatedIRI>
        <Literal xml:lang="en">Event</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T051</AbbreviatedIRI>
        <Literal xml:lang="en">A broad type for grouping activities, processes and states.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T052</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T052</AbbreviatedIRI>
        <Literal xml:lang="en">Activity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T052</AbbreviatedIRI>
        <Literal xml:lang="en">An operation or series of operations that an organism or machine carries out or participates in.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T067</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T067</AbbreviatedIRI>
        <Literal xml:lang="en">Phenomenon or Process</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T067</AbbreviatedIRI>
        <Literal xml:lang="en">A process or state which occurs naturally or as a result of an activity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T071</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T071</AbbreviatedIRI>
        <Literal xml:lang="en">Entity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T071</AbbreviatedIRI>
        <Literal xml:lang="en">A broad type for grouping physical and conceptual entities.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T072</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T072</AbbreviatedIRI>
        <Literal xml:lang="en">Physical Object</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T072</AbbreviatedIRI>
        <Literal xml:lang="en">An object perceptible to the sense of vision or touch.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T077</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T077</AbbreviatedIRI>
        <Literal xml:lang="en">Conceptual Entity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T077</AbbreviatedIRI>
        <Literal xml:lang="en">A broad type for grouping abstract entities or concepts.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:exactMatch"/>
        <AbbreviatedIRI>sty:T077</AbbreviatedIRI>
        <Literal>Thesaurus:C20181 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C20181)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T170</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T170</AbbreviatedIRI>
        <Literal xml:lang="en">Intellectual Product</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T170</AbbreviatedIRI>
        <Literal xml:lang="en">A conceptual entity resulting from human endeavor. Concepts assigned to this type generally refer to information created by humans for some purpose.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T194</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T194</AbbreviatedIRI>
        <Literal xml:lang="en">Archaeon</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T194</AbbreviatedIRI>
        <Literal xml:lang="en">A member of one of the three domains of life, formerly called Archaebacteria under the taxon Bacteria, but now considered separate and distinct. Archaea are characterized by: 1) the presence of characteristic tRNAs and ribosomal RNAs; 2) the absence of peptidoglycan cell walls; 3) the presence of ether-linked lipids built from branched-chain subunits; and 4) their occurrence in unusual habitats. While archaea resemble bacteria in morphology and genomic organization, they resemble eukarya in their method of genomic replication.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:exactMatch"/>
        <AbbreviatedIRI>sty:T194</AbbreviatedIRI>
        <Literal>Thesaurus:C61092 (http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C61092)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sty:T204</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/STY</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>sty:T204</AbbreviatedIRI>
        <Literal xml:lang="en">Eukaryote</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>sty:T204</AbbreviatedIRI>
        <Literal xml:lang="en">One of the three domains of life (the others being Bacteria and Archaea), also called Eukarya. These are organisms whose cells are enclosed in membranes and possess a nucleus. They comprise almost all multicellular and many unicellular organisms, and are traditionally divided into groups (sometimes called kingdoms) including Animals, Plants, Fungi, various Algae, and other taxa that were previously part of the old kingdom Protista.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <AbbreviatedIRI>roo:P100040</AbbreviatedIRI>
        <Literal>Andre Dekker</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>roo:P100040</AbbreviatedIRI>
        <Literal xml:lang="en">associated_with</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>roo:P100040</AbbreviatedIRI>
        <Literal xml:lang="en">has a significant or salient relationship to.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <IRI>DKFZ000006</IRI>
        <Literal>Wahyu W. Hadiwikarta and Abumansur Sabyrrakhim</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000006</IRI>
        <Literal>Animal Identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>DKFZ000006</IRI>
        <Literal>An identifier which is used to uniquely identify an animal in a certain context (cohort, hospital, trial). Can be a pseudonym.</Literal>
    </AnnotationAssertion>
