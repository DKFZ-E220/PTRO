        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000199</IRI>
        <Literal>Upper end of reference range for continuous measurements in standardized units. Should be populated only for continuous results.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
