        <AbbreviatedIRI>ncit:C54100</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/NCIT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ncit:C54100</AbbreviatedIRI>
        <Literal xml:lang="en">Universally Unique Identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>ncit:C54100</AbbreviatedIRI>
        <Literal xml:lang="en">A 128 bit identifier. Depending on the mechanism used to generate it, it is either guaranteed to be different from all other UUIDs/GUIDs generated until 3400 AD or extremely likely to be different. Its relatively small size lends itself well to sorting, ordering, and hashing of all sorts, storing in databases, simple allocation, and ease of programming in general.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <AbbreviatedIRI>ncit:C62289</AbbreviatedIRI>
        <Literal>OGiraldo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>ncit:C62289</AbbreviatedIRI>
        <Literal>http://purl.bioontology.org/ontology/NCIT</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>ncit:C62289</AbbreviatedIRI>
        <Literal>Domain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <AbbreviatedIRI>ncit:C62289</AbbreviatedIRI>
        <Literal>An area of knowledge considered as a discrete unit for some purpose.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
