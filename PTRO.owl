    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <IRI>DKFZ000197</IRI>
        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000197</IRI>
        <Literal>Standardized unit used for LBSTRESC and LBSTRESN.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>DKFZ000197</IRI>
        <Literal>Unit_of_the_Standardized_Result</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <IRI>DKFZ000197</IRI>
        <Literal>LBSTRESU</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <IRI>DKFZ000198</IRI>
        <Literal>S.V.Ilango</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>DKFZ000198</IRI>
        <Literal>Lower end of reference range for continuous measurements in standardized units. Should be populated only for continuous results.</Literal>
    </AnnotationAssertion>
