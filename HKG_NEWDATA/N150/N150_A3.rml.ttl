@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix ncit: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>.
@prefix ptro: <http://www.radplanbio.org/ptro/>.
@prefix ro: <http://purl.obolibrary.org/obo/ro.owl>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@base <http://example.com/ns#>.

<#TriplesMap1> a rr:TriplesMap;
	
  rml:logicalSource [ 
		rml:source      "/data/A3_CO_N150_30f6Wo_NaCl,Cispl._54Gy.csv";
    rml:referenceFormulation ql:CSV
  ];
    
	rr:subjectMap [
		rr:template   "http://www.radplanbio.org/ptro/instance/{SUBJID}";
		rr:class ptro:DKFZ000080;
		rr:termType rr:IRI;
	];
   
	rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000010;
    rr:objectMap [ rml:reference "SUBJID" ];
	];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000042;
    rr:objectMap [ rml:reference "DOMAIN" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000115;
    rr:objectMap [ rml:reference "PUID" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000120;
    rr:objectMap [ rml:reference "COHORT" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000051;
    rr:objectMap [ rml:reference "POOLID" ];
  ];

   
  rr:predicateObjectMap [
    rr:predicate rdfs:label;
    rr:objectMap [ rml:reference "SUBJID" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000146;
    rr:objectMap [ rml:reference "COSEQ" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000008;
    rr:objectMap [ rml:reference "STUDYID" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000091;
    rr:objectMap [ rml:reference "IDVAR" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000092;
    rr:objectMap [ rml:reference "IDVARVAL" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000147;
    rr:objectMap [ rml:reference "COREF" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000093;
    rr:objectMap [ rml:reference "COVAL" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000094;
    rr:objectMap [ rml:reference "COEVAL" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000095;
    rr:objectMap [ rml:reference "CODTC" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000096;
    rr:objectMap [ rml:reference "CODY" ];
  ];

  rr:predicateObjectMap [
    rr:predicate ptro:DKFZ000009;
    rr:objectMap [ rml:reference "USUBJID" ];
  ];

.
